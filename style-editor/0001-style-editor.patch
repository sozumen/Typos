+	}
+
+	.sai-row {
+		display: flex;
+		align-items: center;
+		flex-wrap: wrap;
+		gap: 8px;
+		margin-bottom: 6px;
+
+		input[type="password"] {
+			flex: 1;
+			min-width: 12em;
+		}
+	}
+
+	.sai-field {

+		border-color: transparent;
+
+		&:disabled {
+			opacity: .45;
+		}
+	}
+
+	.sai-actions {
+		margin-top: 12px;
+	}
+
+	#sai-advanced {
+		margin: 4px 0 8px;
+
+		summary {
+			cursor: default;
+			color: var(--fill-secondary);
+		}
+	}
+
+	#sai-steps {
+		margin: 0;

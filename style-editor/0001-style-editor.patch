+
+
+	// Structure tree
+
+	#vse-tree {
+		flex: 1;
+		overflow: auto;
+		padding: 4px 0 24px;
+		outline: none;
+		background: var(--material-sidepane);
+
+		&:focus-visible {
+			outline: var(--default-focusring-width, 2px) solid var(--color-accent);
+			outline-offset: -2px;
+		}
+	}
+
+	.vse-node {

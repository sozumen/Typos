+				this._checkCanContain(parent, 'group');
+				let group = {
+					id: this._newId(), type: 'element', name: 'group', attrs: [], children: [node], text: null
+				};
+				parent.children.splice(parent.children.indexOf(node), 1, group);
+				groupId = group.id;
+			});
+			return groupId;
+		}
+
+		/** Replace a group by its contents */
+		unwrap(id) {
+			return this._edit(() => {
+				let node = this._require(id);
+				let parent = this.parentOf(id);
+				if (!parent || localName(node.name || '') !== 'group') {
+					throw new CSLEditError('invalid', 'Only a group can be ungrouped');
+				}
+				for (let c of node.children) {
+					if (c.type === 'element') this._checkCanContain(parent, c.name);
+				}
+				parent.children.splice(parent.children.indexOf(node), 1, ...node.children);
+			});
+		}
+
+
+		//
+		// Macros
+		//
+
+		macroNode(name) {
+			return this.findAll('macro').find(m => getAttr(m, 'name') === name) || null;
+		}
+
+		macros() {
+			return this.findAll('macro').map(m => ({
+				id: m.id,
+				name: getAttr(m, 'name'),
+				uses: this.macroUsages(getAttr(m, 'name')).length
+			}));
+		}
+
+		/** Nodes (text or key elements) that call the macro */
+		macroUsages(name) {
+			let out = [];
+			this.walk((n) => {
+				let kind = localName(n.name);
+				if ((kind === 'text' || kind === 'key') && getAttr(n, 'macro') === name) out.push(n);
+			});
+			return out;
+		}
+
+		unusedMacros() {
+			return this.macros().filter(m => m.uses === 0);
+		}
+
+		/** Names that are called but not defined */
+		undefinedMacros() {
+			let defined = new Set(this.macros().map(m => m.name));
+			let missing = new Set();
+			this.walk((n) => {
+				let kind = localName(n.name);
+				let ref = getAttr(n, 'macro');
+				if ((kind === 'text' || kind === 'key') && ref && !defined.has(ref)) missing.add(ref);
+			});
+			return [...missing];
+		}
+
+		static isValidMacroName(name) {
+			return MACRO_NAME_RE.test(name || '');
+		}
+
+		addMacro(name) {
+			if (!StyleDoc.isValidMacroName(name)) {
+				throw new CSLEditError('invalid-name', 'Macro names start with a letter and use only letters, numbers, ".", "_" and "-"');
+			}
+			if (this.macroNode(name)) {
+				throw new CSLEditError('duplicate', `There is already a macro called "${name}"`);
+			}
+			return this.insert(this._root.id, { name: 'macro', attrs: { name } });
+		}
+
+		/** Rename a macro and every place that uses it */
+		renameMacro(id, newName) {
+			return this._edit(() => {
+				let node = this._require(id);
+				if (localName(node.name || '') !== 'macro') {
+					throw new CSLEditError('invalid', 'Not a macro');
+				}
+				let old = getAttr(node, 'name');
+				if (old === newName) return false;
+				if (!StyleDoc.isValidMacroName(newName)) {
+					throw new CSLEditError('invalid-name', 'Macro names start with a letter and use only letters, numbers, ".", "_" and "-"');
+				}
+				if (this.macroNode(newName)) {
+					throw new CSLEditError('duplicate', `There is already a macro called "${newName}"`);
+				}
+				for (let use of this.macroUsages(old)) {
+					use.attrs.find(a => a.name === 'macro').value = newName;
+				}
+				node.attrs.find(a => a.name === 'name').value = newName;
+			});
+		}
+
+
+		//
+		// Style information
+		//
+
+		getInfo(name) {
+			let info = this.findAll('info')[0];
+			if (!info) return null;
+			let el = elementChildren(info).find(c => localName(c.name) === name);
+			return el ? el.text : null;
+		}
+
+		/**
+		 * Set a field of the style's information block. Clearing an optional field removes it;
+		 * the title, id and updated time are required, so they are kept even when empty.
+		 */
+		setInfo(name, value) {
+			return this._edit(() => {
+				let info = this.findAll('info')[0];
+				if (!info) throw new CSLEditError('required', 'This style has no information block');
+				let el = elementChildren(info).find(c => localName(c.name) === name);
+				let clearing = value === '' || value === null || value === undefined;
+				if (clearing && !['title', 'id', 'updated'].includes(name)) {
+					if (!el) return false;
+					info.children.splice(info.children.indexOf(el), 1);
+					return;
+				}
+				if (value === null || value === undefined) value = '';
+				if (el) {
+					if (el.text === value) return false;
+					el.text = value;
+				}
+				else {
+					info.children.push({
+						id: this._newId(), type: 'element', name, attrs: [], children: [], text: value
+					});
+				}
+			});
+		}
+
+
+		//
+		// Descriptions for the editor
+		//
+
+		/**
+		 * A short title and a one-line detail for a node, for the tree view
+		 * @return {{ kind: string, title: string, detail: string }}
+		 */
+		describe(id) {
+			let node = this._require(id);
+			if (node.type === 'comment') {
+				return { kind: 'comment', title: 'Comment', detail: node.value.trim().slice(0, 60) };
+			}
+			if (node.type === 'text') {
+				return { kind: 'text-node', title: 'Text', detail: node.value.trim().slice(0, 60) };
+			}
+			let kind = localName(node.name);
+			let a = name => getAttr(node, name);
+			let title = Schema.getElement(kind)?.label || kind;
+			let detail = [];
+
+			switch (kind) {
+				case 'text':
+					if (a('variable')) title = `Variable: ${a('variable')}`;
+					else if (a('macro')) title = `Macro: ${a('macro')}`;
+					else if (a('term')) title = `Term: ${a('term')}`;
+					else if (a('value') !== null) title = `Text: “${a('value')}”`;
+					break;
+				case 'number':
+				case 'label':
+				case 'date':
+					if (a('variable')) title = `${title}: ${a('variable')}`;
+					break;
+				case 'names':
+					if (a('variable')) title = `Names: ${a('variable').split(/\s+/).join(', ')}`;
+					break;
+				case 'name-part':
+					title = `Name part: ${a('name') || '?'}`;
+					break;
+				case 'date-part':
+					title = `Date part: ${a('name') || '?'}`;
+					break;
+				case 'macro':
+					title = `Macro: ${a('name') || '?'}`;
+					break;
+				case 'key':
+					title = `Sort by ${a('variable') || a('macro') || '?'}`;
+					if (a('sort') === 'descending') detail.push('descending');
+					break;
+				case 'if':
+				case 'else-if': {
+					let parts = ['type', 'variable', 'is-numeric', 'is-uncertain-date', 'locator', 'position']
+						.filter(n => a(n))
+						.map(n => `${n} ${a(n)}`);
+					title = `${title}${parts.length ? ' ' + parts.join(', ') : ''}`;
+					if (parts.length > 1 && a('match') && a('match') !== 'all') detail.push(`match ${a('match')}`);
+					break;
+				}
+				case 'info':
+					title = 'Style information';
+					break;
+				case 'locale':
+					title = `Locale${a('xml:lang') ? ': ' + a('xml:lang') : ''}`;
+					break;
+				default:
+					break;
+			}
+
+			let formats = [];
+			if (a('font-style') && a('font-style') !== 'normal') formats.push(a('font-style'));
+			if (a('font-weight') && a('font-weight') !== 'normal') formats.push(a('font-weight'));
+			if (a('font-variant') === 'small-caps') formats.push('small caps');
+			if (a('text-decoration') === 'underline') formats.push('underline');
+			if (a('vertical-align') && a('vertical-align') !== 'baseline') {
+				formats.push(a('vertical-align') === 'sup' ? 'superscript' : 'subscript');
+			}
+			if (a('quotes') === 'true') formats.push('quotes');
+			if (a('text-case')) formats.push(a('text-case'));
+			if (formats.length) detail.push(formats.join(', '));
+			if (a('prefix')) detail.push(`before “${a('prefix')}”`);
+			if (a('suffix')) detail.push(`after “${a('suffix')}”`);
+			if (a('delimiter') && ['group', 'layout', 'names', 'name', 'date'].includes(kind)) {
+				detail.push(`separated by “${a('delimiter')}”`);
+			}
+			return { kind, title, detail: detail.join(' · ') };
+		}
+
+		/**
+		 * Problems worth showing next to an attribute, or null. Never blocks an edit; the real
+		 * validator has the last word.
+		 */
+		checkAttr(id, name, value) {
+			let node = this._require(id);
+			let spec = Schema.getElement(node.name)?.attrs[name];
+			if (!spec || value === null || value === undefined || value === '') return null;
+			switch (spec.type) {
+				case 'enum':
+					return spec.values.includes(value) ? null : `Expected one of: ${spec.values.join(', ')}`;
+				case 'enum-multi': {
+					let bad = value.split(/\s+/).filter(v => v && !spec.values.includes(v));
+					return bad.length ? `Unknown value: ${bad.join(', ')}` : null;
+				}
+				case 'integer':
+					return /^\d+$/.test(value) ? null : 'Expected a whole number';
+				case 'variable':
+				case 'variables': {
+					let bad = value.split(/\s+/).filter(v => v && !Schema.ALL_VARIABLES.includes(v));
+					return bad.length ? `Not a standard CSL variable: ${bad.join(', ')}` : null;
+				}
+				case 'item-types': {
+					let bad = value.split(/\s+/).filter(v => v && !Schema.ITEM_TYPES.includes(v));
+					return bad.length ? `Not a CSL item type: ${bad.join(', ')}` : null;
+				}
+				case 'macro':
+					return this.macroNode(value) ? null : `There is no macro called "${value}"`;
+				default:
+					return null;
+			}
+		}
+	}
+
+	const api = {
+		CSLParseError,
+		CSLEditError,
+		parse,
+		serialize,
+		nodeAtLine,
+		elementChildren,
+		getAttr,
+		StyleDoc
+	};
+
+	if (typeof module !== 'undefined' && module.exports) {
+		module.exports = api;
+	}
+	else if (root) {
+		root.CSLTree = api;
+	}
+})(typeof Zotero !== 'undefined' ? Zotero : null);
diff --git a/chrome/content/zotero/xpcom/styleEditor/styleCopy.js b/chrome/content/zotero/xpcom/styleEditor/styleCopy.js
new file mode 100644
index 0000000..081cc95
--- /dev/null
+++ b/chrome/content/zotero/xpcom/styleEditor/styleCopy.js
@@ -0,0 +1,98 @@
+"use strict";
+
+/**
+ * Preparing styles for the visual editor: making an editable working copy of an installed style,
+ * and stamping a style when it is saved
+ *
+ * Editing an installed style never changes that style. The editor opens a copy with its own ID and
+ * title, linked back to the original, so saving it adds a new style next to the one it came from.
+ *
+ * Tested in plain Node: fork/test/styleCopy.test.js
+ */
+(function (root) {
+	const isNode = typeof module !== 'undefined' && module.exports;
+	const Tree = isNode ? require('./cslTree.js') : root.CSLTree;
+	const Templates = isNode ? require('./cslTemplates.js') : root.CSLTemplates;
+	const { StyleDoc, elementChildren, getAttr } = Tree;
+
+	class DependentStyleError extends Error {
+		constructor(message) {
+			super(message);
+			this.name = 'DependentStyleError';
+		}
+	}
+
+	/** A dependent style borrows another style's layout, so it has nothing here to edit */
+	function isDependent(doc) {
+		return doc.findAll('layout').length === 0;
+	}
+
+	function infoNode(doc) {
+		return doc.findAll('info')[0];
+	}
+
+	function linksWithRel(doc, rels) {
+		let info = infoNode(doc);
+		return elementChildren(info).filter(c => c.name === 'link' && rels.includes(getAttr(c, 'rel')));
+	}
+
+	/**
+	 * @param {String} xml - The style to copy
+	 * @param {Object} [options]
+	 * @param {Iterable<String>} [options.existingIds] - IDs already taken
+	 * @param {String} [options.titleSuffix=' (custom)']
+	 * @param {String} [options.now] - ISO date-time for cs:updated; defaults to now
+	 * @return {{ xml: String, id: String, title: String, originalID: String|null }}
+	 * @throws {DependentStyleError} if the style has no layout of its own
+	 */
+	function makeWorkingCopy(xml, options = {}) {
+		let doc = StyleDoc.fromXML(xml);
+		if (isDependent(doc)) {
+			throw new DependentStyleError('This style takes its layout from another style, so there is nothing to edit in it');
+		}
+		let info = infoNode(doc);
+		if (!info) throw new Error('This style has no information block');
+
+		let originalID = doc.getInfo('id');
+		let title = (doc.getInfo('title') || 'Untitled style') + (options.titleSuffix === undefined ? ' (custom)' : options.titleSuffix);
+		let id = Templates.makeStyleId(title, options.existingIds || []);
+
+		// The new style is not the one at its old address, and is never a dependent
+		for (let link of linksWithRel(doc, ['self', 'independent-parent', 'template'])) doc.remove(link.id);
+
+		doc.setInfo('title', title);
+		doc.setInfo('id', id);
+		doc.setInfo('updated', options.now || new Date().toISOString());
+		if (originalID) doc.insert(info.id, { name: 'link', attrs: { href: originalID, rel: 'template' } });
+
+		return { xml: doc.toXML(), id, title, originalID };
+	}
+
+	/** The style as it should be written out: the update time refreshed */
+	function stampForSave(xml, now) {
+		let doc = StyleDoc.fromXML(xml);
+		if (!infoNode(doc)) return xml;
+		doc.setInfo('updated', now || new Date().toISOString());
+		return doc.toXML();
+	}
+
+	/** Title and ID of a style, or nulls if it cannot be read */
+	function readIdentity(xml) {
+		try {
+			let doc = StyleDoc.fromXML(xml);
+			return { id: doc.getInfo('id'), title: doc.getInfo('title') };
+		}
+		catch (e) {
+			return { id: null, title: null };
+		}
+	}
+
+	const api = { DependentStyleError, isDependent, makeWorkingCopy, stampForSave, readIdentity };
+
+	if (isNode) {
+		module.exports = api;
+	}
+	else if (root) {
+		root.StyleCopy = api;
+	}
+})(typeof Zotero !== 'undefined' ? Zotero : null);
diff --git a/chrome/content/zotero/xpcom/styleEditor/stylePreview.js b/chrome/content/zotero/xpcom/styleEditor/stylePreview.js
new file mode 100644
index 0000000..9af4e8c
--- /dev/null
+++ b/chrome/content/zotero/xpcom/styleEditor/stylePreview.js
@@ -0,0 +1,142 @@
+"use strict";
+
+/**
+ * Renders what a style produces, for the live preview in the visual style editor
+ *
+ * This follows what the built-in text editor (tools/csledit.js) does -- individual citations, a
+ * combined citation, and a bibliography -- but returns HTML for a sandboxed frame instead of
+ * writing into a document, and escapes error messages.
+ *
+ * Needs the running application (Zotero.Style, Zotero.Cite). The XML it is given is not
+ * installed or saved.
+ */
+Zotero.StylePreview = new function () {
+	// Positions the CSL processor understands; the numbers are its own
+	const POSITIONS = [
+		{ id: 'first', value: 0 },
+		{ id: 'subsequent', value: 1 },
+		{ id: 'ibid', value: 2 },
+		{ id: 'ibid-with-locator', value: 3 },
+		{ id: 'near-note', value: 4 }
+	];
+	this.POSITIONS = POSITIONS;
+
+	function escapeHTML(str) {
+		return String(str)
+			.replace(/&/g, '&amp;')
+			.replace(/</g, '&lt;')
+			.replace(/>/g, '&gt;')
+			.replace(/"/g, '&quot;');
+	}
+	this.escapeHTML = escapeHTML;
+
+	function fail(message, error) {
+		return {
+			html: `<div class="message error">${escapeHTML(message)}${error ? `<div>${escapeHTML(error)}</div>` : ''}</div>`,
+			ok: false
+		};
+	}
+
+	/**
+	 * @param {String} xml - CSL
+	 * @param {Object} options
+	 * @param {Zotero.Item[]} options.items
+	 * @param {String} [options.locale='en-US']
+	 * @param {String} [options.locator] - Pin cite, e.g. "45"
+	 * @param {String} [options.locatorLabel='page']
+	 * @param {Boolean} [options.suppressAuthor=false]
+	 * @param {String} [options.position='first'] - One of POSITIONS
+	 * @return {{ html: String, ok: Boolean }} - `html` is a fragment to place in the preview frame
+	 */
+	this.render = function (xml, options = {}) {
+		let items = options.items || [];
+		let locale = options.locale || 'en-US';
+		let position = POSITIONS.find(p => p.id === options.position) || POSITIONS[0];
+
+		let style;
+		try {
+			style = new Zotero.Style(xml);
+		}
+		catch (e) {
+			return fail(Zotero.getString('styles.editor.warning.parseError'), e);
+		}
+		if (!items.length) {
+			return {
+				html: `<div class="message warning">${escapeHTML(Zotero.getString('styles.editor.warning.noItems'))}</div>`,
+				ok: false
+			};
+		}
+
+		let engine;
+		try {
+			engine = style.getCiteProc(style.locale || locale, 'html');
+		}
+		catch (e) {
+			return fail(Zotero.getString('styles.editor.warning.parseError'), e);
+		}
+
+		try {
+			let ids = items.map(item => item.id);
+			engine.updateItems(ids);
+
+			let cites = ids.map((id) => {
+				let cite = { id, 'suppress-author': !!options.suppressAuthor };
+				if (options.locator) {
+					cite.locator = options.locator;
+					cite.label = options.locatorLabel || 'page';
+				}
+				if (position.id === 'near-note') {
+					// A near note is a subsequent citation with near-note set
+					cite.position = 1;
+					cite['near-note'] = true;
+				}
+				else {
+					cite.position = position.value;
+				}
+				return cite;
+			});
+
+			let html = `<h3>${escapeHTML(Zotero.getString('styles.editor.output.individualCitations'))}</h3>`;
+			for (let cite of cites) {
+				html += engine.makeCitationCluster([cite]) + '<br />';
+			}
+
+			let citation = { citationItems: cites, properties: { noteIndex: 1 } };
+			html += `<hr><h3>${escapeHTML(Zotero.getString('styles.editor.output.singleCitation'))}</h3>`
+				+ engine.previewCitationCluster(citation, [], [], 'html');
+
+			engine.updateItems(ids);
+			html += `<hr><h3>${escapeHTML(Zotero.getString('styles.bibliography'))}</h3>`
+				+ Zotero.Cite.makeFormattedBibliography(engine, 'html');
+			return { html, ok: true };
+		}
+		catch (e) {
+			Zotero.logError(e);
+			return fail(Zotero.getString('styles.editor.warning.renderError'), e);
+		}
+		finally {
+			engine.free();
+		}
+	};
+
+	/**
+	 * A complete, self-contained document for a sandboxed iframe's srcdoc. It carries its own
+	 * styles, because a sandboxed frame cannot load the application's stylesheet.
+	 */
+	this.wrapDocument = function (fragment) {
+		return `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
+			:root { color-scheme: light dark; }
+			body { font: 13px/1.45 system-ui, sans-serif; margin: 0; padding: 12px 16px; }
+			h3 { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; opacity: .65;
+				margin: 14px 0 6px; font-weight: 600; }
+			h3:first-child { margin-top: 0; }
+			hr { border: 0; border-top: 1px solid rgba(127,127,127,.3); margin: 14px 0 0; }
+			.csl-bib-body { margin: 0; }
+			.csl-entry { margin-bottom: .6em; }
+			.message { padding: 8px 10px; border-radius: 6px; }
+			.message.error { background: rgba(200,40,40,.14); }
+			.message.warning { background: rgba(200,150,20,.16); }
+			.message div { margin-top: 4px; font-family: monospace; font-size: 12px; }
+		</style></head><body>${fragment}</body></html>`;
+	};
+}();
diff --git a/chrome/content/zotero/xpcom/styleEditor/visualStyleEditor.js b/chrome/content/zotero/xpcom/styleEditor/visualStyleEditor.js
new file mode 100644
index 0000000..2700bd2
--- /dev/null
+++ b/chrome/content/zotero/xpcom/styleEditor/visualStyleEditor.js
@@ -0,0 +1,109 @@
+"use strict";
+
+/**
+ * Opening the visual style editor and connecting it to the application's list of styles
+ *
+ * The editor itself is a window (tools/visualStyleEditor.html). This module opens or focuses it,
+ * hands it the style to start from, and installs finished styles. Windows can't be passed
+ * arguments with window.open(), but every window shares the Zotero object, so a request is parked
+ * here and the window collects it as it loads.
+ *
+ *   Zotero.VisualStyleEditor.open()                              last-used style, as a working copy
+ *   Zotero.VisualStyleEditor.open({ styleID })                   a working copy of an installed style
+ *   Zotero.VisualStyleEditor.open({ kind: 'note', title: 'X' })  a new style from a template
+ *   Zotero.VisualStyleEditor.open({ xml, title })                this CSL (e.g. one written by the AI)
+ *
+ * Pure logic is in cslTree.js, cslTemplates.js and styleCopy.js (tested in plain Node).
+ */
+Zotero.VisualStyleEditor = new function () {
+	const WINDOW_TYPE = 'zotero:visual-style-editor';
+	const WINDOW_URL = 'chrome://zotero/content/tools/visualStyleEditor.html';
+	const WINDOW_FEATURES = 'chrome,width=1280,height=800,resizable,centerscreen';
+
+	var _pending = null;
+
+	this.WINDOW_TYPE = WINDOW_TYPE;
+
+	/**
+	 * @param {Object} [request]
+	 * @param {String} [request.styleID] - Edit a copy of this installed style
+	 * @param {String} [request.kind] - 'author-date', 'numeric' or 'note': start from a template
+	 * @param {String} [request.title] - Title for a new or imported style
+	 * @param {String} [request.xml] - Open exactly this CSL
+	 * @param {String} [request.notice] - A message to show on opening (e.g. what the AI changed)
+	 */
+	this.open = function (request = {}) {
+		let existing = Services.wm.getMostRecentWindow(WINDOW_TYPE);
+		if (existing && existing.Zotero_VisualStyleEditor) {
+			existing.focus();
+			existing.Zotero_VisualStyleEditor.openRequest(request);
+			return existing;
+		}
+		_pending = request;
+		return Services.ww.openWindow(null, WINDOW_URL, '_blank', WINDOW_FEATURES, null);
+	};
+
+	/** Called by the editor window as it loads */
+	this.takePending = function () {
+		let request = _pending;
+		_pending = null;
+		return request;
+	};
+
+	/** IDs of every installed style, visible or not */
+	this.getInstalledStyleIDs = function () {
+		return Object.keys(Zotero.Styles.getAll());
+	};
+
+	/** Installed styles that have a layout of their own, so can be edited, sorted by title */
+	this.getEditableStyles = function () {
+		return Zotero.Styles.getVisible()
+			.filter(style => !style.source)
+			.sort((a, b) => a.title.localeCompare(b.title));
+	};
+
+	/** A working copy of an installed style: { xml, id, title, originalID } */
+	this.makeWorkingCopy = function (styleID) {
+		let style = Zotero.Styles.get(styleID);
+		if (!style) throw new Error(`No installed style ${styleID}`);
+		return Zotero.StyleCopy.makeWorkingCopy(style.getXML(), {
+			existingIds: this.getInstalledStyleIDs()
+		});
+	};
+
+	/** A new style from a template: { xml, id, title } */
+	this.makeNewStyle = function (kind, title) {
+		let id = Zotero.CSLTemplates.makeStyleId(title || 'Untitled style', this.getInstalledStyleIDs());
+		let xml = Zotero.CSLTemplates.newStyleXML(kind, {
+			title: title || 'Untitled style',
+			id,
+			locale: Zotero.Prefs.get('export.lastLocale') || 'en-US'
+		});
+		return { xml, id, title: title || 'Untitled style' };
+	};
+
+	/**
+	 * Check a style against the CSL schema
+	 * @return {Promise<String|null>} - The validator's messages, or null if the style is valid
+	 */
+	this.validate = async function (xml) {
+		try {
+			await Zotero.Styles.validate(xml);
+			return null;
+		}
+		catch (errors) {
+			return String(errors);
+		}
+	};
+
+	/**
+	 * Add a style to the application, stamping it with the current time. Zotero's own install
+	 * code asks before replacing a style that is already installed and reports other problems.
+	 * @return {Promise<{ styleID: String, styleTitle: String }|null>} - null if it was not installed
+	 */
+	this.install = async function (xml) {
+		let stamped = Zotero.StyleCopy.stampForSave(xml);
+		let result = await Zotero.Styles.install({ string: stamped }, 'Visual Style Editor', false);
+		return result && result.styleID ? result : null;
+	};
+}();

+		display: none !important;
+	}
+
+	// The root element is the html element itself
+	&, body {
+		height: 100%;
+	}
+
+	body {
+		display: flex;
+		flex-direction: column;
+		margin: 0;
+		font-size: 12px;
+		background: var(--material-background);
+		color: var(--fill-primary, inherit);
+	}

diff --git a/docs/STYLE-EDITOR.md b/docs/STYLE-EDITOR.md
new file mode 100644
index 0000000..f323b13
--- /dev/null
+++ b/docs/STYLE-EDITOR.md
@@ -0,0 +1,82 @@
+# Visual Style Editor and AI style writer
+
+**Tools → Visual Style Editor…** and **Tools → Write a Style with AI…**
+(also: Preferences → Cite → *Visual Style Editor…*).
+
+## The editor
+
+A window with three panes:
+
+- **Structure**: the style as a tree of its parts (macros, citation, bibliography, layouts,
+  groups, text, names, dates, choose/if/else, sort keys). Select a part, then use the toolbar or the
+  keyboard to add, move, duplicate, wrap in a group, unwrap, or delete it. Parts can be dragged.
+  The editor will not let you make a change that breaks the style's structure (for example
+  putting `else` before `if`, or anything after `substitute`); it tells you why.
+- **Details**: a form for the selected part, built from the CSL specification. Text can be a
+  variable, a macro, a term or fixed text; formatting (italic, bold, small caps…) is one click; prefix,
+  suffix and delimiter show a visible marker for spaces. Renaming a macro updates every place that
+  uses it. The *XML* button switches this pane to the raw CSL, which you can edit directly.
+- **Preview**: citations and a bibliography from the items selected in your library, using the
+  style as you edit it. Choose the locale, first/subsequent/ibid position, a locator, and whether
+  to suppress the author.
+
+Every change is checked against the CSL schema; the status bar shows the verdict, and **Show in
+structure** selects the part at fault. Undo and redo cover everything.
+
+Editing never changes an installed style in place. Opening one makes a **working copy** with its
+own ID and a title ending "(custom)", linked to the original as its template. **Install** adds it
+to the application (asking before replacing one with the same ID). **Save as…** writes a `.csl`
+file. Styles that only point to a parent style (dependent styles) have no layout of their own;
+the editor says so and offers the parent.
+
+**New style…** starts from an author-date, numeric or note template.
+
+## The AI style writer
+
+Give Claude a style manual (PDF, text, Markdown, HTML, or pasted text), example citations, extra
+instructions, or any mix. It writes a complete CSL file, the application checks it against the CSL
+schema and for macros that are called but not defined, and any problems are sent back to Claude to
+fix (up to two rounds). The result opens in the editor as an **unsaved** style with Claude's notes
+(assumptions, rules CSL can't express), so you review it and fix whatever's left by hand before
+installing. It can also **revise** the style open in the editor.
+
+Tips:
+
+- Examples of every kind of source you cite, with the in-text form next to the bibliography
+  form, work best. Mark italics with `*asterisks*`.
+- For a long manual, give it only the chapters on citations and bibliographies. Limits: about 24 MB
+  or 100 pages of PDF, 400,000 characters of text.
+- **Always check the output against your manual.** A style can be valid CSL and still wrong.
+
+### Privacy and cost
+
+- It uses **your own Claude API key** (created at console.anthropic.com). You pay Anthropic directly.
+- What is sent to Anthropic: the manual, examples and notes you add (a PDF is sent whole), and, when
+  revising, the style being revised. **Nothing from your library is sent.** The dialog says this the
+  first time and asks you to acknowledge it.
+- The key is stored in the login manager, encrypted with your operating system's key store (like the
+  sync key). It is sent only to `api.anthropic.com` and is never written to the debug log. Request
+  bodies aren't logged either.
+- The model is `claude-sonnet-5-5` by default; change it under *Advanced* in the dialog (preference
+  `extensions.zotero.styleAI.model`).
+
+## Code map
+
+| Piece | File |
+|---|---|
+| CSL grammar data (elements, attributes, variables) | `xpcom/styleEditor/cslSchema.js` |
+| Parse, serialize, and every edit operation, with undo | `xpcom/styleEditor/cslTree.js` |
+| Starter templates | `xpcom/styleEditor/cslTemplates.js` |
+| Working copies of installed styles | `xpcom/styleEditor/styleCopy.js` |
+| Preview rendering | `xpcom/styleEditor/stylePreview.js` |
+| Opening the editor, installing | `xpcom/styleEditor/visualStyleEditor.js` |
+| Editor window | `tools/visualStyleEditor.{html,js}`, `scss/components/_visualStyleEditor.scss` |
+| Claude Messages API client | `xpcom/styleAI/claudeClient.js` |
+| Prompt, reply parsing, style cleanup | `xpcom/styleAI/styleGenPrompt.js` |
+| Write, check, repair loop | `xpcom/styleAI/styleGenerator.js` |
+| Key storage, file reading, requests | `xpcom/styleAI/styleAI.js` |
+| AI dialog | `tools/styleAI.{html,js}`, `scss/components/_styleAI.scss` |
+| Strings | `zotero.ftl` (`visualStyleEditor-*`, `styleAI-*`) |
+
+Tests: `node --test fork/test/*.test.js` (`cslTree`, `cslSchema`, `styleCopy`, `claudeClient`,
+`styleGenPrompt`, `styleGenerator`, `styleEditorL10n`).
diff --git a/fork/test/claudeClient.test.js b/fork/test/claudeClient.test.js
new file mode 100644
index 0000000..3a0e75f
--- /dev/null
+++ b/fork/test/claudeClient.test.js
@@ -0,0 +1,138 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createClient, ClaudeAPIError, describeError } = require('../../chrome/content/zotero/xpcom/styleAI/claudeClient.js');
+
+function ok(text, extra = {}) {
+	return {
+		status: 200,
+		text: JSON.stringify(Object.assign({
+			content: [{ type: 'text', text }],
+			stop_reason: 'end_turn',
+			usage: { input_tokens: 10, output_tokens: 5 },
+			model: 'claude-sonnet-5-5'
+		}, extra))
+	};
+}
+
+function fake(responses) {
+	let calls = [];
+	let request = async (url, options) => {
+		calls.push({ url, options });
+		let next = responses.shift();
+		if (next instanceof Error) throw next;
+		return next;
+	};
+	return { request, calls };
+}
+
+const noSleep = () => { let waits = []; let f = async ms => { waits.push(ms); }; f.waits = waits; return f; };
+
+test('sends the documented request and returns the text', async () => {
+	let { request, calls } = fake([ok('Hello')]);
+	let client = createClient({ apiKey: 'sk-test', request, sleep: noSleep() });
+	let reply = await client.send({ system: 'Be brief', messages: [{ role: 'user', content: 'Hi' }] });
+	assert.equal(reply.text, 'Hello');
+	assert.equal(reply.stopReason, 'end_turn');
+	assert.deepEqual(reply.usage, { input_tokens: 10, output_tokens: 5 });
+
+	assert.equal(calls.length, 1);
+	assert.equal(calls[0].url, 'https://api.anthropic.com/v1/messages');
+	assert.equal(calls[0].options.method, 'POST');
+	assert.equal(calls[0].options.headers['x-api-key'], 'sk-test');
+	assert.equal(calls[0].options.headers['anthropic-version'], '2023-06-01');
+	let body = JSON.parse(calls[0].options.body);
+	assert.equal(body.model, 'claude-sonnet-5-5');
+	assert.equal(body.system, 'Be brief');
+	assert.ok(body.max_tokens > 0);
+	assert.deepEqual(body.messages, [{ role: 'user', content: 'Hi' }]);
+});
+
+test('joins several text blocks and ignores other blocks', async () => {
+	let { request } = fake([{ status: 200, text: JSON.stringify({ content: [{ type: 'text', text: 'a' }, { type: 'thinking', thinking: 'x' }, { type: 'text', text: 'b' }] }) }]);
+	let reply = await createClient({ apiKey: 'k', request }).send({ messages: [] });
+	assert.equal(reply.text, 'ab');
+});
+
+test('uses the model and token limit it is given', async () => {
+	let { request, calls } = fake([ok('x')]);
+	let client = createClient({ apiKey: 'k', request, model: 'claude-opus-5-5', maxTokens: 123 });
+	await client.send({ messages: [] });
+	let body = JSON.parse(calls[0].options.body);
+	assert.equal(body.model, 'claude-opus-5-5');
+	assert.equal(body.max_tokens, 123);
+	assert.equal('system' in body, false);
+});
+
+test('refuses to start without a key or a request function', () => {
+	assert.throws(() => createClient({ request: async () => {} }), e => e.kind === 'auth');
+	assert.throws(() => createClient({ apiKey: 'k' }), /request function/);
+});
+
+for (let [status, kind] of [[401, 'auth'], [403, 'auth'], [413, 'too-large'], [400, 'invalid'], [404, 'invalid']]) {
+	test(`HTTP ${status} is "${kind}" and not retried`, async () => {
+		let { request, calls } = fake([{ status, text: JSON.stringify({ error: { message: 'Because.' } }) }]);
+		let sleep = noSleep();
+		await assert.rejects(
+			createClient({ apiKey: 'k', request, sleep }).send({ messages: [] }),
+			e => e instanceof ClaudeAPIError && e.kind === kind && e.status === status && e.message === 'Because.'
+		);
+		assert.equal(calls.length, 1);
+		assert.deepEqual(sleep.waits, []);
+	});
+}
+
+test('429 and 529 are retried with a longer wait each time, then succeed', async () => {
+	let { request, calls } = fake([{ status: 429, text: '{}' }, { status: 529, text: '{}' }, ok('done')]);
+	let sleep = noSleep();
+	let reply = await createClient({ apiKey: 'k', request, sleep }).send({ messages: [] });
+	assert.equal(reply.text, 'done');
+	assert.equal(calls.length, 3);
+	assert.deepEqual(sleep.waits, [2000, 6000]);
+});
+
+test('gives up after the retries and reports the last error', async () => {
+	let { request, calls } = fake([{ status: 500, text: 'oops' }, { status: 500, text: 'oops' }, { status: 503, text: 'oops' }]);
+	await assert.rejects(
+		createClient({ apiKey: 'k', request, sleep: noSleep() }).send({ messages: [] }),
+		e => e.kind === 'overloaded' && e.status === 503 && /HTTP 503/.test(e.message)
+	);
+	assert.equal(calls.length, 3);
+});
+
+test('retries can be turned off', async () => {
+	let { request, calls } = fake([{ status: 429, text: '{}' }]);
+	await assert.rejects(createClient({ apiKey: 'k', request, retries: 0 }).send({ messages: [] }), e => e.kind === 'rate-limit');
+	assert.equal(calls.length, 1);
+});
+
+test('a request that gets no response is a network error and is not retried', async () => {
+	let { request, calls } = fake([new Error('offline')]);
+	await assert.rejects(
+		createClient({ apiKey: 'k', request, sleep: noSleep() }).send({ messages: [] }),
+		e => e.kind === 'network' && /offline/.test(e.message)
+	);
+	assert.equal(calls.length, 1);
+});
+
+test('replies that are not what the API sends are "bad-reply"', async () => {
+	for (let text of ['not json', '{}', JSON.stringify({ content: 'x' })]) {
+		let { request } = fake([{ status: 200, text }]);
+		await assert.rejects(createClient({ apiKey: 'k', request }).send({ messages: [] }), e => e.kind === 'bad-reply', text);
+	}
+});
+
+test('the API key never appears in an error message', async () => {
+	let { request } = fake([{ status: 401, text: '{"error":{"message":"invalid x-api-key"}}' }]);
+	await assert.rejects(createClient({ apiKey: 'sk-secret-123', request }).send({ messages: [] }), e => !e.message.includes('sk-secret-123'));
+});
+
+test('describeError gives something to act on for each kind', () => {
+	for (let kind of ['auth', 'rate-limit', 'overloaded', 'too-large']) {
+		assert.ok(describeError(new ClaudeAPIError(kind, 'raw')).length > 20, kind);
+		assert.notEqual(describeError(new ClaudeAPIError(kind, 'raw')), 'raw');
+	}
+	assert.equal(describeError(new ClaudeAPIError('invalid', 'Bad field')), 'Bad field');
+	assert.equal(describeError(new Error('plain')), 'plain');
+});
diff --git a/fork/test/cslSchema.test.js b/fork/test/cslSchema.test.js
new file mode 100644
index 0000000..29dedb4
--- /dev/null
+++ b/fork/test/cslSchema.test.js
@@ -0,0 +1,96 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const Schema = require('../../chrome/content/zotero/xpcom/styleEditor/cslSchema.js');
+const Templates = require('../../chrome/content/zotero/xpcom/styleEditor/cslTemplates.js');
+
+test('localName drops a namespace prefix', () => {
+	assert.equal(Schema.localName('cs:text'), 'text');
+	assert.equal(Schema.localName('text'), 'text');
+});
+
+test('canContain follows the CSL structure', () => {
+	assert.equal(Schema.canContain('group', 'text'), true);
+	assert.equal(Schema.canContain('group', 'group'), true);
+	assert.equal(Schema.canContain('group', 'name'), false);
+	assert.equal(Schema.canContain('names', 'name'), true);
+	assert.equal(Schema.canContain('names', 'substitute'), true);
+	assert.equal(Schema.canContain('text', 'text'), false);
+	assert.equal(Schema.canContain('choose', 'else'), true);
+	assert.equal(Schema.canContain('layout', 'if'), false);
+	assert.equal(Schema.canContain('style', 'macro'), true);
+	assert.equal(Schema.canContain('cs:macro', 'cs:text'), true);
+	assert.equal(Schema.canContain('nonsense', 'text'), false);
+});
+
+test('every element named as a child is itself described', () => {
+	// The contents of cs:info and cs:locale are metadata and term definitions, which the editor
+	// shows as plain fields rather than describing each element
+	let opaque = ['info', 'locale'];
+	for (let [name, spec] of Object.entries(Schema.ELEMENTS)) {
+		if (opaque.includes(name)) continue;
+		for (let child of spec.children) {
+			assert.ok(Schema.ELEMENTS[child], `${name} lists unknown child ${child}`);
+		}
+	}
+});
+
+test('groupAttrs sorts attributes into the inspector sections', () => {
+	let g = Schema.groupAttrs('text');
+	assert.deepEqual(g.affixes.map(a => a.name), ['prefix', 'suffix']);
+	// Punctuation is grouped, with the delimiter after the affixes whichever way the schema lists it
+	assert.deepEqual(Schema.groupAttrs('group').affixes.map(a => a.name), ['prefix', 'suffix', 'delimiter']);
+	assert.deepEqual(Schema.groupAttrs('layout').affixes.map(a => a.name), ['prefix', 'suffix', 'delimiter']);
+	assert.ok(g.formatting.some(a => a.name === 'font-style'));
+	assert.ok(g.formatting.some(a => a.name === 'quotes'));
+	assert.ok(g.main.some(a => a.name === 'variable'));
+	assert.equal(g.names.length, 0);
+	let n = Schema.groupAttrs('name');
+	assert.ok(n.names.some(a => a.name === 'initialize-with'));
+	assert.deepEqual(Schema.groupAttrs('bogus'), { main: [], affixes: [], formatting: [], names: [] });
+});
+
+test('enumerated attributes list their values', () => {
+	let style = Schema.ELEMENTS.text.attrs['font-style'];
+	assert.deepEqual(style.values, ['normal', 'italic', 'oblique']);
+	assert.equal(Schema.ELEMENTS.name.attrs.and.values.includes('symbol'), true);
+});
+
+test('addableChildren offers output elements, and macros at the top level', () => {
+	let inGroup = Schema.addableChildren('group');
+	assert.ok(inGroup.includes('text') && inGroup.includes('names') && inGroup.includes('choose'));
+	assert.ok(Schema.addableChildren('style').includes('macro'));
+	assert.ok(Schema.addableChildren('choose').includes('else-if'));
+	assert.deepEqual(Schema.addableChildren('text'), []);
+});
+
+test('variableKind classifies variables', () => {
+	assert.equal(Schema.variableKind('author'), 'names');
+	assert.equal(Schema.variableKind('issued'), 'date');
+	assert.equal(Schema.variableKind('volume'), 'number');
+	assert.equal(Schema.variableKind('title'), 'standard');
+	assert.equal(Schema.variableKind('nope'), null);
+});
+
+test('slugify and makeStyleId make safe, unique ids', () => {
+	assert.equal(Templates.slugify('Journal of Hellenic Studies (JHS)'), 'journal-of-hellenic-studies-jhs');
+	assert.equal(Templates.slugify('  Café Études  '), 'cafe-etudes');
+	assert.equal(Templates.slugify('???'), 'untitled-style');
+	let id = Templates.makeStyleId('My Style');
+	assert.equal(id, 'http://typos.local/styles/my-style');
+	assert.equal(Templates.makeStyleId('My Style', [id]), id + '-2');
+	assert.equal(Templates.makeStyleId('My Style', [id, id + '-2']), id + '-3');
+});
+
+test('newStyleXML fills in the title, id, class and locale, and escapes them', () => {
+	let xml = Templates.newStyleXML('note', {
+		title: 'A & B <test>', id: 'http://x.org/a', locale: 'de-DE', updated: '2026-01-01T00:00:00Z'
+	});
+	assert.match(xml, /class="note"/);
+	assert.match(xml, /default-locale="de-DE"/);
+	assert.match(xml, /<title>A &amp; B &lt;test&gt;<\/title>/);
+	assert.match(xml, /<id>http:\/\/x\.org\/a<\/id>/);
+	assert.match(Templates.newStyleXML('author-date'), /class="in-text"/);
+	assert.throws(() => Templates.newStyleXML('bogus'), /Unknown style kind/);
+});
diff --git a/fork/test/cslTree.test.js b/fork/test/cslTree.test.js
new file mode 100644
index 0000000..5bc01fb
--- /dev/null
+++ b/fork/test/cslTree.test.js
@@ -0,0 +1,586 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const Tree = require('../../chrome/content/zotero/xpcom/styleEditor/cslTree.js');
+const Templates = require('../../chrome/content/zotero/xpcom/styleEditor/cslTemplates.js');
+const { StyleDoc, CSLParseError, CSLEditError } = Tree;
+
+const SMALL = `<?xml version="1.0" encoding="utf-8"?>
+<!-- a comment before the root is dropped -->
+<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0">
+  <info>
+    <title>Small &amp; simple</title>
+    <id>http://example.org/small</id>
+    <updated>2026-01-01T00:00:00Z</updated>
+  </info>
+  <locale xml:lang="en">
+    <terms>
+      <term name="page"><single>page</single><multiple>pages</multiple></term>
+    </terms>
+  </locale>
+  <macro name="author">
+    <names variable="author">
+      <name and="text" delimiter=", "/>
+    </names>
+  </macro>
+  <macro name="year">
+    <date variable="issued"><date-part name="year"/></date>
+  </macro>
+  <citation>
+    <layout prefix="(" suffix=")" delimiter="; ">
+      <!-- inside a layout -->
+      <group delimiter=", ">
+        <text macro="author"/>
+        <text macro="year"/>
+      </group>
+    </layout>
+  </citation>
+  <bibliography>
+    <sort><key macro="author"/></sort>
+    <layout>
+      <text macro="author"/>
+      <choose>
+        <if type="book"><text variable="title" font-style="italic"/></if>
+        <else-if variable="container-title"><text variable="title" quotes="true"/></else-if>
+        <else><text value="untitled"/></else>
+      </choose>
+    </layout>
+  </bibliography>
+</style>
+`;
+
+function doc() {
+	return StyleDoc.fromXML(SMALL);
+}
+
+function first(d, name) {
+	return d.findAll(name)[0];
+}
+
+
+//
+// Reading and writing
+//
+
+test('parse reads elements, attributes, entities and text', () => {
+	let d = doc();
+	assert.equal(d.root.name, 'style');
+	assert.equal(d.getAttr(d.root.id, 'class'), 'in-text');
+	assert.equal(d.getInfo('title'), 'Small & simple');
+	assert.equal(first(d, 'single').text, 'page');
+});
+
+test('whitespace that only lays out the file is not kept as content', () => {
+	let d = doc();
+	assert.equal(first(d, 'info').text, null);
+	assert.ok(first(d, 'info').children.every(c => c.type === 'element'));
+});
+
+test('serialize then parse gives the same tree', () => {
+	let d = doc();
+	let again = StyleDoc.fromXML(d.toXML());
+	assert.equal(again.toXML(), d.toXML());
+	assert.equal(again.findAll('text').length, d.findAll('text').length);
+});
+
+test('serialize escapes special characters in text and attributes', () => {
+	let d = doc();
+	let t = d.findAll('text').find(n => n.attrs.some(a => a.name === 'value'));
+	d.setAttr(t.id, 'value', 'a < b & "c"');
+	d.setInfo('summary', 'x < y & z');
+	let xml = d.toXML();
+	assert.match(xml, /value="a &lt; b &amp; &quot;c&quot;"/);
+	assert.match(xml, /<summary>x &lt; y &amp; z<\/summary>/);
+	let back = StyleDoc.fromXML(xml);
+	assert.equal(back.getAttr(back.findAll('text').find(n => n.attrs.some(a => a.name === 'value')).id, 'value'), 'a < b & "c"');
+	assert.equal(back.getInfo('summary'), 'x < y & z');
+});
+
+test('comments inside the style are kept', () => {
+	let d = doc();
+	assert.match(d.toXML(), /<!-- inside a layout -->/);
+});
+
+test('a lone space in an attribute survives a round trip', () => {
+	let d = doc();
+	let grp = first(d, 'group');
+	d.setAttr(grp.id, 'suffix', ' ');
+	let back = StyleDoc.fromXML(d.toXML());
+	assert.equal(back.getAttr(first(back, 'group').id, 'suffix'), ' ');
+});
+
+test('parse errors name the problem and the position', () => {
+	assert.throws(() => StyleDoc.fromXML(''), CSLParseError);
+	assert.throws(() => StyleDoc.fromXML('<style><info></style>'), /does not match/);
+	assert.throws(() => StyleDoc.fromXML('<style a="1" a="2"/>'), /appears twice/);
+	assert.throws(() => StyleDoc.fromXML('<style a=1/>'), /in quotes/);
+	assert.throws(() => StyleDoc.fromXML('<style>&bogus;</style>'), /Unknown entity/);
+	assert.throws(() => StyleDoc.fromXML('<style>a & b</style>'), /bare "&"/);
+	assert.throws(() => StyleDoc.fromXML('<style/><style/>'), /after the closing tag/);
+	try {
+		StyleDoc.fromXML('<style>\n<info>\n</style>');
+		assert.fail('should have thrown');
+	}
+	catch (e) {
+		assert.equal(e.name, 'CSLParseError');
+		assert.equal(e.line, 3);
+	}
+});
+
+test('numeric character references and CDATA are read', () => {
+	let d = StyleDoc.fromXML('<style><info><title>caf&#233; &#x2014; <![CDATA[<raw>]]></title></info></style>');
+	assert.equal(d.getInfo('title'), 'café — <raw>');
+});
+
+test('every template parses and round-trips', () => {
+	for (let kind of Object.keys(Templates.KINDS)) {
+		let xml = Templates.newStyleXML(kind, { title: 'T', updated: '2026-01-01T00:00:00Z' });
+		let d = StyleDoc.fromXML(xml);
+		assert.equal(StyleDoc.fromXML(d.toXML()).toXML(), d.toXML(), kind);
+		assert.equal(d.undefinedMacros().length, 0, `${kind} calls a macro it does not define`);
+		assert.equal(d.unusedMacros().length, 0, `${kind} defines a macro it never uses`);
+	}
+});
+
+
+//
+// Attributes
+//
+
+test('setAttr adds, changes and removes', () => {
+	let d = doc();
+	let g = first(d, 'group');
+	assert.equal(d.setAttr(g.id, 'prefix', '['), true);
+	assert.equal(d.getAttr(g.id, 'prefix'), '[');
+	assert.equal(d.setAttr(g.id, 'prefix', '('), true);
+	assert.equal(d.getAttr(g.id, 'prefix'), '(');
+	assert.equal(d.setAttr(g.id, 'prefix', ''), true);
+	assert.equal(d.getAttr(g.id, 'prefix'), null);
+});
+
+test('setting an attribute to its current value is not an edit', () => {
+	let d = doc();
+	let g = first(d, 'group');
+	assert.equal(d.setAttr(g.id, 'delimiter', ', '), false);
+	assert.equal(d.canUndo(), false);
+	assert.equal(d.setAttr(g.id, 'prefix', ''), false);
+});
+
+test('checkAttr warns about odd values but does not block them', () => {
+	let d = doc();
+	let t = d.findAll('text').find(n => n.attrs.some(a => a.name === 'variable'));
+	assert.equal(d.checkAttr(t.id, 'variable', 'title'), null);
+	assert.match(d.checkAttr(t.id, 'variable', 'titel'), /Not a standard CSL variable/);
+	assert.match(d.checkAttr(t.id, 'font-style', 'slanted'), /Expected one of/);
+	assert.match(d.checkAttr(t.id, 'macro', 'nope'), /no macro called/);
+	assert.equal(d.setAttr(t.id, 'font-style', 'slanted'), true);
+});
+
+
+//
+// Structure
+//
+
+test('insert checks what the parent may contain', () => {
+	let d = doc();
+	let layout = d.findAll('layout')[0];
+	assert.throws(() => d.insert(layout.id, { name: 'info' }), (e) => e.code === 'invalid-parent');
+	assert.throws(() => d.insert(first(d, 'name').id, { name: 'text' }), CSLEditError);
+	let id = d.insert(layout.id, { name: 'text', attrs: { variable: 'title' } });
+	assert.equal(layout.children.at(-1).id, id);
+});
+
+test('a failed insert leaves the style untouched', () => {
+	let d = doc();
+	let before = d.toXML();
+	assert.throws(() => d.insert(first(d, 'layout').id, { name: 'info' }));
+	assert.equal(d.toXML(), before);
+	assert.equal(d.canUndo(), false);
+});
+
+test('new macros are placed with the other macros, before the citation', () => {
+	let d = doc();
+	d.addMacro('title');
+	let kinds = d.root.children.filter(c => c.type === 'element').map(c => c.name);
+	assert.deepEqual(kinds, ['info', 'locale', 'macro', 'macro', 'macro', 'citation', 'bibliography']);
+	assert.equal(d.root.children.filter(c => c.name === 'macro').at(-1).attrs[0].value, 'title');
+});
+
+test('macro names must be valid and unique', () => {
+	let d = doc();
+	assert.throws(() => d.addMacro('author'), (e) => e.code === 'duplicate');
+	assert.throws(() => d.addMacro('1bad'), (e) => e.code === 'invalid-name');
+	assert.throws(() => d.addMacro('has space'), (e) => e.code === 'invalid-name');
+});
+
+test('addBranch keeps a choose in order', () => {
+	let d = doc();
+	let choose = first(d, 'choose');
+	d.addBranch(choose.id, 'else-if');
+	let names = choose.children.map(c => c.name);
+	assert.deepEqual(names, ['if', 'else-if', 'else-if', 'else']);
+	assert.throws(() => d.addBranch(choose.id, 'else'), (e) => e.code === 'order');
+});
+
+test('an else branch cannot be moved above other branches', () => {
+	let d = doc();
+	let choose = first(d, 'choose');
+	let els = choose.children.find(c => c.name === 'else');
+	assert.equal(d.canMoveBy(els.id, -1), false);
+	let before = d.toXML();
+	assert.throws(() => d.moveBy(els.id, -1), (e) => e.code === 'order');
+	// The failed move rolled back, so look the node up again by id
+	assert.deepEqual(d.find(choose.id).children.map(c => c.name), ['if', 'else-if', 'else']);
+	assert.equal(d.toXML(), before);
+	assert.equal(d.canUndo(), false);
+});
+
+test('canMoveBy is a pure question: it never disturbs the tree', () => {
+	let d = doc();
+	let choose = first(d, 'choose');
+	let ifNode = choose.children[0];
+	assert.equal(d.canMoveBy(ifNode.id, 1), false); // would put else-if first
+	assert.equal(d.canMoveBy(choose.children[1].id, 1), false); // would pass the else
+	assert.equal(first(d, 'choose'), choose);
+	assert.equal(choose.children[0], ifNode);
+	assert.equal(d.canMoveBy(first(d, 'group').children[0].id, 1), true);
+	assert.equal(d.canMoveBy(first(d, 'group').children[1].id, 1), false);
+});
+
+test('moveBy reorders siblings', () => {
+	let d = doc();
+	let grp = first(d, 'group');
+	let [a, b] = grp.children;
+	assert.equal(d.moveBy(a.id, 1), true);
+	assert.deepEqual(grp.children.map(c => c.id), [b.id, a.id]);
+	assert.equal(d.moveBy(a.id, 1), false);
+});
+
+test('move can change parent and refuses cycles', () => {
+	let d = doc();
+	let grp = first(d, 'group');
+	let layout = first(d, 'layout');
+	let author = grp.children[0];
+	d.move(author.id, layout.id, 0);
+	assert.equal(layout.children[0].id, author.id);
+	assert.equal(grp.children.length, 1);
+	assert.throws(() => d.move(grp.id, grp.id), (e) => e.code === 'cycle');
+	assert.throws(() => d.move(first(d, 'if').id, layout.id), (e) => e.code === 'invalid-parent');
+});
+
+test('moving a node later within its parent lands where asked', () => {
+	let d = doc();
+	let layout = d.findAll('layout')[1];
+	let [text, choose] = layout.children;
+	d.move(text.id, layout.id, 2);
+	assert.deepEqual(layout.children.map(c => c.id), [choose.id, text.id]);
+});
+
+test('required parts cannot be removed', () => {
+	let d = doc();
+	assert.throws(() => d.remove(first(d, 'info').id), (e) => e.code === 'required');
+	assert.throws(() => d.remove(first(d, 'layout').id), (e) => e.code === 'required');
+	assert.throws(() => d.remove(first(d, 'citation').id), (e) => e.code === 'required');
+	assert.throws(() => d.remove(first(d, 'if').id), (e) => e.code === 'required');
+	assert.throws(() => d.remove(d.root.id), (e) => e.code === 'root');
+	assert.equal(d.canRemove(first(d, 'info').id), false);
+});
+
+test('remove deletes an element and its contents', () => {
+	let d = doc();
+	let before = d.findAll('text').length;
+	d.remove(first(d, 'group').id);
+	assert.equal(first(d, 'group'), undefined);
+	assert.equal(d.findAll('text').length, before - 2);
+});
+
+test('duplicate copies with fresh ids', () => {
+	let d = doc();
+	let grp = first(d, 'group');
+	let copyId = d.duplicate(grp.id);
+	let copy = d.find(copyId);
+	assert.notEqual(copyId, grp.id);
+	assert.equal(copy.children.length, 2);
+	assert.ok(copy.children.every((c, i) => c.id !== grp.children[i].id));
+	let ids = [];
+	d.walk(n => ids.push(n.id));
+	assert.equal(new Set(ids).size, ids.length);
+});
+
+test('duplicating a macro gives it a new name', () => {
+	let d = doc();
+	d.duplicate(first(d, 'macro').id);
+	d.duplicate(first(d, 'macro').id);
+	let names = d.macros().map(m => m.name);
+	assert.deepEqual(names, ['author', 'author-copy-2', 'author-copy', 'year']);
+});
+
+test('wrapInGroup and unwrap are inverses', () => {
+	let d = doc();
+	let before = d.toXML();
+	let layout = d.findAll('layout')[1];
+	let t = layout.children[0];
+	let gid = d.wrapInGroup(t.id);
+	assert.equal(layout.children[0].id, gid);
+	assert.equal(layout.children[0].children[0].id, t.id);
+	d.unwrap(gid);
+	assert.equal(d.toXML(), before);
+	assert.throws(() => d.wrapInGroup(first(d, 'info').id), (e) => e.code === 'invalid');
+	assert.throws(() => d.unwrap(t.id), (e) => e.code === 'invalid');
+});
+
+
+//
+// Macros
+//
+
+test('renaming a macro updates everything that calls it', () => {
+	let d = doc();
+	let m = first(d, 'macro');
+	assert.equal(d.macroUsages('author').length, 3); // citation, bibliography layout, sort key
+	d.renameMacro(m.id, 'creators');
+	assert.equal(d.macroUsages('author').length, 0);
+	assert.equal(d.macroUsages('creators').length, 3);
+	assert.deepEqual(d.undefinedMacros(), []);
+});
+
+test('renaming a macro refuses duplicates and bad names', () => {
+	let d = doc();
+	let m = first(d, 'macro');
+	assert.throws(() => d.renameMacro(m.id, 'year'), (e) => e.code === 'duplicate');
+	assert.throws(() => d.renameMacro(m.id, 'no good'), (e) => e.code === 'invalid-name');
+	assert.equal(d.macroNode('author') !== null, true);
+});
+
+test('a macro that is still used cannot be removed; an unused one can', () => {
+	let d = doc();
+	assert.throws(() => d.remove(first(d, 'macro').id), (e) => e.code === 'used-macro');
+	let id = d.addMacro('spare');
+	assert.deepEqual(d.unusedMacros().map(m => m.name), ['spare']);
+	d.remove(id);
+	assert.equal(d.macroNode('spare'), null);
+});
+
+test('undefinedMacros reports calls with no definition', () => {
+	let d = doc();
+	d.setAttr(d.macroUsages('year')[0].id, 'macro', 'yeer');
+	assert.deepEqual(d.undefinedMacros(), ['yeer']);
+});
+
+
+//
+// History and state
+//
+
+test('undo and redo walk back and forth', () => {
+	let d = doc();
+	let original = d.toXML();
+	let g = first(d, 'group');
+	d.setAttr(g.id, 'prefix', '[');
+	d.remove(d.findAll('text')[0].id);
+	let edited = d.toXML();
+	assert.notEqual(edited, original);
+	assert.equal(d.undo(), true);
+	assert.equal(d.undo(), true);
+	assert.equal(d.toXML(), original);
+	assert.equal(d.undo(), false);
+	assert.equal(d.redo(), true);
+	assert.equal(d.redo(), true);
+	assert.equal(d.toXML(), edited);
+	assert.equal(d.canRedo(), false);
+});
+
+test('a new edit clears the redo history', () => {
+	let d = doc();
+	let g = first(d, 'group');
+	d.setAttr(g.id, 'prefix', '[');
+	d.undo();
+	assert.equal(d.canRedo(), true);
+	d.setAttr(g.id, 'prefix', '(');
+	assert.equal(d.canRedo(), false);
+});
+
+test('ids stay valid across undo', () => {
+	let d = doc();
+	let g = first(d, 'group');
+	let id = g.id;
+	d.setAttr(id, 'prefix', '[');
+	d.undo();
+	assert.equal(d.find(id).name, 'group');
+	d.redo();
+	assert.equal(d.getAttr(id, 'prefix'), '[');
+});
+
+test('ids are not reused after an undone insert', () => {
+	let d = doc();
+	let a = d.insert(first(d, 'layout').id, { name: 'text', attrs: { variable: 'title' } });
+	d.undo();
+	let b = d.insert(first(d, 'layout').id, { name: 'text', attrs: { variable: 'title' } });
+	assert.notEqual(a, b);
+});
+
+test('isDirty tracks changes since the last save', () => {
+	let d = doc();
+	assert.equal(d.isDirty(), false);
+	d.setAttr(first(d, 'group').id, 'prefix', '[');
+	assert.equal(d.isDirty(), true);
+	d.markSaved();
+	assert.equal(d.isDirty(), false);
+	d.undo();
+	assert.equal(d.isDirty(), true);
+});
+
+test('onChange fires for edits, undo and redo, but not for failed edits', () => {
+	let d = doc();
+	let calls = 0;
+	d.onChange(() => calls++);
+	d.setAttr(first(d, 'group').id, 'prefix', '[');
+	assert.equal(calls, 1);
+	assert.throws(() => d.insert(first(d, 'layout').id, { name: 'info' }));
+	assert.equal(calls, 1);
+	d.undo();
+	d.redo();
+	assert.equal(calls, 3);
+});
+
+test('info fields can be read and written', () => {
+	let d = doc();
+	assert.equal(d.getInfo('id'), 'http://example.org/small');
+	d.setInfo('title', 'Renamed');
+	d.setInfo('summary', 'New field');
+	assert.equal(d.getInfo('title'), 'Renamed');
+	assert.equal(d.getInfo('summary'), 'New field');
+	assert.equal(d.getInfo('rights'), null);
+});
+
+
+//
+// Descriptions for the tree view
+//
+
+test('describe gives readable titles', () => {
+	let d = doc();
+	let desc = id => d.describe(id);
+	let textWith = (attr) => d.findAll('text').find(n => n.attrs.some(a => a.name === attr));
+	assert.equal(desc(textWith('macro').id).title, 'Macro: author');
+	assert.equal(desc(textWith('value').id).title, 'Text: “untitled”');
+	let italic = d.findAll('text').find(n => n.attrs.some(a => a.name === 'font-style'));
+	assert.equal(desc(italic.id).title, 'Variable: title');
+	assert.equal(desc(italic.id).detail, 'italic');
+	assert.equal(desc(first(d, 'if').id).title, 'If type book');
+	assert.equal(desc(first(d, 'else-if').id).title, 'Else if variable container-title');
+	assert.equal(desc(first(d, 'else').id).title, 'Else');
+	assert.equal(desc(first(d, 'layout').id).detail, 'before “(” · after “)” · separated by “; ”');
+	assert.equal(desc(first(d, 'names').id).title, 'Names: author');
+});
+
+
+//
+// Line mapping and whole-document replacement
+//
+
+test('toXMLWithLines maps each node to the line it starts on', () => {
+	let d = doc();
+	let { xml, lineMap } = d.toXMLWithLines();
+	let lines = xml.split('\n');
+	let group = first(d, 'group');
+	assert.match(lines[lineMap.get(group.id) - 1], /^\s*<group delimiter=", ">$/);
+	let macroText = d.findAll('text')[0];
+	assert.match(lines[lineMap.get(macroText.id) - 1], /<text macro="author"\/>/);
+	assert.match(lines[lineMap.get(d.root.id) - 1], /^<style /);
+});
+
+test('nodeAtLine finds the innermost node for a line', () => {
+	let d = doc();
+	let { xml, lineMap } = d.toXMLWithLines();
+	let lines = xml.split('\n');
+	let at = (re) => lines.findIndex(l => re.test(l)) + 1;
+	let t = d.find(Tree.nodeAtLine(lineMap, at(/<text variable="title" quotes="true"\/>/)));
+	assert.equal(t.name, 'text');
+	assert.equal(d.getAttr(t.id, 'quotes'), 'true');
+	let g = d.find(Tree.nodeAtLine(lineMap, at(/<group delimiter/)));
+	assert.equal(g.name, 'group');
+	// A line inside a block but not at a child start belongs to the block
+	assert.equal(d.find(Tree.nodeAtLine(lineMap, at(/<\/group>/))).name, 'text');
+	assert.equal(Tree.nodeAtLine(new Map(), 5), null);
+});
+
+test('replaceXML swaps the whole style and can be undone', () => {
+	let d = doc();
+	let original = d.toXML();
+	let other = Templates.newStyleXML('numeric', { title: 'Other', updated: '2026-01-01T00:00:00Z' });
+	assert.equal(d.replaceXML(other), true);
+	assert.equal(d.getInfo('title'), 'Other');
+	assert.equal(d.root.attrs.find(a => a.name === 'class').value, 'in-text');
+	d.undo();
+	assert.equal(d.toXML(), original);
+	d.redo();
+	assert.equal(d.getInfo('title'), 'Other');
+});
+
+test('replaceXML with unreadable XML changes nothing', () => {
+	let d = doc();
+	let before = d.toXML();
+	let kept = first(d, 'group');
+	assert.throws(() => d.replaceXML('<style><oops></style>'), CSLParseError);
+	assert.equal(d.toXML(), before);
+	assert.equal(first(d, 'group'), kept);
+	assert.equal(d.canUndo(), false);
+});
+
+test('replaceXML gives every new node a fresh id', () => {
+	let d = doc();
+	let old = new Set();
+	d.walk(n => old.add(n.id));
+	d.replaceXML(SMALL);
+	let ids = [];
+	d.walk(n => ids.push(n.id));
+	assert.equal(new Set(ids).size, ids.length);
+	assert.ok(ids.every(id => !old.has(id)));
+});
+
+test('isDirty is about content, not node identity', () => {
+	let d = doc();
+	d.replaceXML(d.toXML());
+	assert.equal(d.isDirty(), false);
+});
+
+
+//
+// Multi-attribute edits and optional info fields
+//
+
+test('setAttrs applies several changes as one undoable step', () => {
+	let d = doc();
+	let t = d.findAll('text').find(n => n.attrs.some(a => a.name === 'macro'));
+	assert.equal(d.setAttrs(t.id, { macro: null, variable: 'title', 'font-style': 'italic' }), true);
+	assert.equal(d.getAttr(t.id, 'macro'), null);
+	assert.equal(d.getAttr(t.id, 'variable'), 'title');
+	assert.equal(d.getAttr(t.id, 'font-style'), 'italic');
+	d.undo();
+	assert.equal(d.getAttr(t.id, 'macro'), 'author');
+	assert.equal(d.getAttr(t.id, 'variable'), null);
+	assert.equal(d.getAttr(t.id, 'font-style'), null);
+	assert.equal(d.canUndo(), false);
+});
+
+test('setAttrs with nothing to change is not an edit', () => {
+	let d = doc();
+	let g = first(d, 'group');
+	assert.equal(d.setAttrs(g.id, { delimiter: ', ', prefix: '' }), false);
+	assert.equal(d.canUndo(), false);
+});
+
+test('clearing an optional info field removes it; required ones are kept', () => {
+	let d = doc();
+	d.setInfo('summary', 'something');
+	assert.equal(d.getInfo('summary'), 'something');
+	d.setInfo('summary', '');
+	assert.equal(d.getInfo('summary'), null);
+	assert.doesNotMatch(d.toXML(), /<summary/);
+	assert.equal(d.setInfo('summary', ''), false);
+	d.setInfo('title', '');
+	assert.equal(d.getInfo('title'), '');
+	assert.match(d.toXML(), /<title\/>/);
+});
diff --git a/fork/test/styleCopy.test.js b/fork/test/styleCopy.test.js
new file mode 100644
index 0000000..5be3d1a
--- /dev/null
+++ b/fork/test/styleCopy.test.js
@@ -0,0 +1,82 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { StyleDoc } = require('../../chrome/content/zotero/xpcom/styleEditor/cslTree.js');
+const Templates = require('../../chrome/content/zotero/xpcom/styleEditor/cslTemplates.js');
+const Copy = require('../../chrome/content/zotero/xpcom/styleEditor/styleCopy.js');
+
+const NOW = '2026-10-19T12:00:00Z';
+
+function installedStyle() {
+	let xml = Templates.newStyleXML('author-date', {
+		title: 'Chicago-ish', id: 'http://www.zotero.org/styles/chicago-ish', updated: '2020-01-01T00:00:00Z'
+	});
+	// Give it the links a repository style has
+	let doc = StyleDoc.fromXML(xml);
+	let info = doc.findAll('info')[0];
+	doc.insert(info.id, { name: 'link', attrs: { href: 'http://www.zotero.org/styles/chicago-ish', rel: 'self' } });
+	doc.insert(info.id, { name: 'link', attrs: { href: 'http://example.org/manual', rel: 'documentation' } });
+	return doc.toXML();
+}
+
+test('a working copy gets its own id and title and links back to the original', () => {
+	let copy = Copy.makeWorkingCopy(installedStyle(), { now: NOW });
+	assert.equal(copy.originalID, 'http://www.zotero.org/styles/chicago-ish');
+	assert.equal(copy.title, 'Chicago-ish (custom)');
+	assert.equal(copy.id, 'http://typos.local/styles/chicago-ish-custom');
+	let doc = StyleDoc.fromXML(copy.xml);
+	assert.equal(doc.getInfo('id'), copy.id);
+	assert.equal(doc.getInfo('title'), copy.title);
+	assert.equal(doc.getInfo('updated'), NOW);
+	let rels = doc.findAll('link').map(l => [doc.getAttr(l.id, 'rel'), doc.getAttr(l.id, 'href')]);
+	assert.deepEqual(rels.sort(), [
+		['documentation', 'http://example.org/manual'],
+		['template', 'http://www.zotero.org/styles/chicago-ish']
+	]);
+});
+
+test('a working copy never reuses an id that is taken', () => {
+	let taken = ['http://typos.local/styles/chicago-ish-custom'];
+	let copy = Copy.makeWorkingCopy(installedStyle(), { existingIds: taken, now: NOW });
+	assert.equal(copy.id, 'http://typos.local/styles/chicago-ish-custom-2');
+});
+
+test('the layout is untouched by copying', () => {
+	let original = StyleDoc.fromXML(installedStyle());
+	let copy = StyleDoc.fromXML(Copy.makeWorkingCopy(installedStyle(), { now: NOW }).xml);
+	assert.equal(copy.findAll('layout').length, original.findAll('layout').length);
+	assert.equal(copy.findAll('macro').length, original.findAll('macro').length);
+});
+
+test('a dependent style cannot be copied for editing', () => {
+	let dependent = `<?xml version="1.0"?>
+<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0">
+  <info>
+    <title>Dependent</title>
+    <id>http://example.org/dep</id>
+    <link href="http://example.org/parent" rel="independent-parent"/>
+    <updated>2020-01-01T00:00:00Z</updated>
+  </info>
+</style>`;
+	assert.throws(() => Copy.makeWorkingCopy(dependent), Copy.DependentStyleError);
+	assert.equal(Copy.isDependent(StyleDoc.fromXML(dependent)), true);
+	assert.equal(Copy.isDependent(StyleDoc.fromXML(installedStyle())), false);
+});
+
+test('stampForSave refreshes the updated time and keeps everything else', () => {
+	let xml = installedStyle();
+	let stamped = Copy.stampForSave(xml, NOW);
+	let before = StyleDoc.fromXML(xml);
+	let after = StyleDoc.fromXML(stamped);
+	assert.equal(after.getInfo('updated'), NOW);
+	before.setInfo('updated', NOW);
+	assert.equal(after.toXML(), before.toXML());
+});
+
+test('readIdentity reads title and id, and tolerates bad XML', () => {
+	assert.deepEqual(Copy.readIdentity(installedStyle()), {
+		id: 'http://www.zotero.org/styles/chicago-ish', title: 'Chicago-ish'
+	});
+	assert.deepEqual(Copy.readIdentity('<style'), { id: null, title: null });
+});
diff --git a/fork/test/styleEditorL10n.test.js b/fork/test/styleEditorL10n.test.js
new file mode 100644
index 0000000..a52f3f7
--- /dev/null
+++ b/fork/test/styleEditorL10n.test.js
@@ -0,0 +1,111 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+
+// A missing string shows up as blank text in the running application, with no error, so check
+// here that everything the style editor windows refer to is defined, and nothing defined is unused.
+
+const ROOT = path.join(__dirname, '..', '..');
+const FTL = fs.readFileSync(path.join(ROOT, 'chrome/locale/en-US/zotero/zotero.ftl'), 'utf8');
+
+// Files whose strings must exist
+const SOURCES = [
+	'chrome/content/zotero/tools/visualStyleEditor.html',
+	'chrome/content/zotero/tools/visualStyleEditor.js'
+].concat(
+	fs.existsSync(path.join(ROOT, 'chrome/content/zotero/tools/styleAI.html'))
+		? ['chrome/content/zotero/tools/styleAI.html', 'chrome/content/zotero/tools/styleAI.js']
+		: []
+);
+
+const PREFIXES = ['visualStyleEditor-', 'styleAI-'];
+
+// Ids the code builds from a prefix plus a name
+const DYNAMIC = {
+	'visualStyleEditor-source-': ['variable', 'macro', 'term', 'value'],
+	'visualStyleEditor-format-': ['italic', 'bold', 'small-caps', 'underline', 'superscript', 'subscript', 'quotes'],
+	'styleAI-step-': ['reading', 'writing', 'checking', 'fixing', 'done']
+};
+
+function definedIds() {
+	let ids = new Set();
+	for (let m of FTL.matchAll(/^([A-Za-z][\w-]*)\s*=/gm)) ids.add(m[1]);
+	return ids;
+}
+
+function usedIds() {
+	let used = new Set();
+	let prefixesSeen = new Set();
+	let re = new RegExp(`(?:${PREFIXES.join('|')})[A-Za-z0-9-]*`, 'g');
+	for (let file of SOURCES) {
+		let text = fs.readFileSync(path.join(ROOT, file), 'utf8');
+		for (let [id] of text.matchAll(re)) {
+			if (id.endsWith('-')) prefixesSeen.add(id);
+			else used.add(id);
+		}
+	}
+	return { used, prefixesSeen };
+}
+
+test('every string the style editor windows use is defined in zotero.ftl', () => {
+	let defined = definedIds();
+	let { used } = usedIds();
+	assert.ok(used.size > 50, 'found the strings the editor uses');
+	let missing = [...used].filter(id => !defined.has(id));
+	assert.deepEqual(missing, [], `Missing from zotero.ftl: ${missing.join(', ')}`);
+});
+
+test('strings built from a prefix are all defined, and every prefix is accounted for', () => {
+	let defined = definedIds();
+	let { prefixesSeen } = usedIds();
+	for (let prefix of prefixesSeen) {
+		assert.ok(DYNAMIC[prefix], `The code builds ids starting "${prefix}"; list them in DYNAMIC in this test`);
+	}
+	for (let [prefix, names] of Object.entries(DYNAMIC)) {
+		if (!prefixesSeen.has(prefix)) continue;
+		for (let name of names) {
+			assert.ok(defined.has(prefix + name), `Missing from zotero.ftl: ${prefix}${name}`);
+		}
+	}
+});
+
+test('no style editor string is defined but never used', () => {
+	let defined = definedIds();
+	let { used, prefixesSeen } = usedIds();
+	for (let prefix of prefixesSeen) {
+		for (let name of DYNAMIC[prefix] || []) used.add(prefix + name);
+	}
+	let unused = [...defined].filter(id => PREFIXES.some(p => id.startsWith(p)) && !used.has(id));
+	assert.deepEqual(unused, [], `Defined but unused: ${unused.join(', ')}`);
+});
+
+test('the Tools menu entry has its string', () => {
+	assert.ok(definedIds().has('menu-tools-visual-style-editor'));
+});
+
+test('placeholders in strings match the arguments the code passes', () => {
+	// Each message's { $variables } should be limited to what the editor supplies for it
+	let expected = {
+		'visualStyleEditor-title': ['name'],
+		'visualStyleEditor-title-unsaved': ['name'],
+		'visualStyleEditor-macro-uses': ['count'],
+		'visualStyleEditor-preview-items': ['count'],
+		'visualStyleEditor-status-error': ['message'],
+		'visualStyleEditor-message-saved': ['path'],
+		'visualStyleEditor-message-installed': ['title'],
+		'visualStyleEditor-error-dependent': ['title'],
+		'visualStyleEditor-error-unreadable': ['message'],
+		'visualStyleEditor-info-note': ['updated']
+	};
+	for (let [id, vars] of Object.entries(expected)) {
+		let start = FTL.indexOf(`\n${id} =`);
+		assert.notEqual(start, -1, id);
+		let next = FTL.slice(start + 1).search(/\n[A-Za-z][\w-]*\s*=/);
+		let block = FTL.slice(start, next === -1 ? undefined : start + 1 + next);
+		let found = [...new Set([...block.matchAll(/\$([a-z]+)/g)].map(m => m[1]))].sort();
+		assert.deepEqual(found, vars.slice().sort(), id);
+	}
+});
diff --git a/fork/test/styleGenPrompt.test.js b/fork/test/styleGenPrompt.test.js

+				type: 'button',
+				class: 'vse-toggle',
+				'aria-pressed': doc.getAttr(node.id, tg.attr) === tg.on ? 'true' : 'false',
+				l10n: ['visualStyleEditor-format-' + tg.id],
+				on: {
+					click: () => {
+						let pressed = button.getAttribute('aria-pressed') === 'true';
+						commit(node.id, tg.attr, pressed ? null : tg.on);
+						// Superscript and subscript are one attribute, so refresh the whole row
+						renderInspector();
+					}
+				}
+			});
+			return button;
+		});
+		return buttons.length ? h('div', { class: 'vse-toggles', role: 'group' }, buttons) : null;
+	}
+
+	function renderAttributeForm(box, node) {
+		let kind = kindOf(node);
+		let groups = Schema.groupAttrs(node.name);
+		let handledBySource = SOURCES[kind] || [];
+		let toggled = new Set(TOGGLES.map(tg => tg.attr));
+
+		let main = groups.main.filter(a => !handledBySource.includes(a.name));
+		let content = [
+			SOURCES[kind] ? sourceField(node) : null,
+			main.map(spec => attributeField(node, spec))
+		];
+		let formatting = [
+			toggleRow(node),
+			groups.formatting.filter(a => !toggled.has(a.name)).map(spec => attributeField(node, spec))
+		];
+
+		box.append(
+			section('visualStyleEditor-section-content', content),
+			section('visualStyleEditor-section-formatting', formatting),
+			section('visualStyleEditor-section-punctuation', groups.affixes.map(spec => attributeField(node, spec))),
+			section('visualStyleEditor-section-names', groups.names.map(spec => attributeField(node, spec)))
+		);
+		if (!box.querySelector('.vse-section')) {
+			box.append(h('p', { class: 'vse-empty', l10n: ['visualStyleEditor-no-settings'] }));
+		}
+		if (kind === 'style') {
+			box.append(h('p', { class: 'vse-hint', l10n: ['visualStyleEditor-style-note'] }));
+		}
+	}
+
+	const INFO_FIELDS = [
+		{ name: 'title', label: 'Title' },
+		{ name: 'title-short', label: 'Short title' },
+		{ name: 'id', label: 'ID (a unique web address)' },
+		{ name: 'summary', label: 'Summary' },
+		{ name: 'rights', label: 'License' }
+	];
+
+	function renderInfoForm(box, node) {
+		let fields = INFO_FIELDS.map((info) => {
+			let control = h('input', {
+				type: 'text',
+				spellcheck: 'false',
+				value: doc.getInfo(info.name) || '',
+				on: {
+					input: debounce(() => {
+						applyingFromInspector = true;
+						try {
+							doc.setInfo(info.name, control.value);
+						}
+						catch (e) {
+							showError(e);
+						}
+						finally {
+							applyingFromInspector = false;
+						}
+					}, COMMIT_DELAY)
+				}
+			});
+			return field(info.label, control);
+		});
+		let updated = doc.getInfo('updated');
+		box.append(
+			section('visualStyleEditor-section-about', fields),
+			h('p', { class: 'vse-hint', l10n: ['visualStyleEditor-info-note', { updated: updated || '' }] })
+		);
+	}
+
+	function renderMacroForm(box, node) {
+		let name = doc.getAttr(node.id, 'name') || '';
+		let control = h('input', {
+			type: 'text',
+			spellcheck: 'false',
+			value: name,
+			on: {
+				change: () => {
+					try {
+						doc.renameMacro(node.id, control.value.trim());
+					}
+					catch (e) {
+						showError(e);
+						control.value = doc.getAttr(node.id, 'name') || '';
+					}
+				}
+			}
+		});
+		let uses = doc.macroUsages(name).length;
+		box.append(
+			section('visualStyleEditor-section-content', field(h('span', { l10n: ['visualStyleEditor-macro-name'] }), control)),
+			h('p', {
+				class: 'vse-hint',
+				l10n: [uses ? 'visualStyleEditor-macro-uses' : 'visualStyleEditor-macro-unused', { count: uses }]
+			})
+		);
+	}
+
+
+	//
+	// Validation
+	//
+
+	function scheduleValidate(delay = VALIDATE_DELAY) {
+		clearTimeout(validateTimer);
+		validateTimer = setTimeout(runValidate, delay);
+	}
+
+	async function runValidate() {
+		clearTimeout(validateTimer);
+		let token = ++validateToken;
+		let { xml, lineMap } = doc.toXMLWithLines();
+		document.l10n.setAttributes(refs.validity, 'visualStyleEditor-status-checking');
+		refs.validity.className = '';
+		let errors = await Zotero.VisualStyleEditor.validate(xml);
+		if (token !== validateToken) return;
+
+		let errorLine = null;
+		let message = '';
+		if (errors) {
+			// The first message is the root cause; the rest are knock-on effects
+			let match = /^[^:]*:(\d+):\d+: error: (.+)/m.exec(errors);
+			if (match) {
+				errorLine = Number(match[1]);
+				message = match[2];
+			}
+			else {
+				message = errors.split('\n')[0];
+			}
+		}
+		lastValidation = { errors, lineMap, errorLine };
+
+		if (errors) {
+			document.l10n.setAttributes(refs.validity, 'visualStyleEditor-status-error', { message });
+			refs.validity.className = 'invalid';
+		}
+		else {
+			document.l10n.setAttributes(refs.validity, 'visualStyleEditor-status-valid');
+			refs.validity.className = 'valid';
+		}
+		refs.gotoError.hidden = !(errors && errorLine && nodeAtLine(lineMap, errorLine));
+	}
+
+	function gotoError() {
+		if (!lastValidation || !lastValidation.errorLine) return;
+		let id = nodeAtLine(lastValidation.lineMap, lastValidation.errorLine);
+		if (id !== null && doc.find(id)) selectNode(id);
+	}
+
+
+	//
+	// Preview
+	//
+
+	function populatePreviewControls() {
+		let locales = Object.entries(Zotero.Styles.locales || {}).sort((a, b) => a[1].localeCompare(b[1]));
+		let fallback = Zotero.Styles.resolveLocale(Zotero.locale);
+		if (fallback && !locales.some(([code]) => code === fallback)) locales.unshift([fallback, fallback]);
+		refs.previewLocale.replaceChildren(...locales.map(([code, name]) => h('option', { value: code, text: name })));
+		refs.previewLocale.value = Zotero.Prefs.get('export.lastLocale') || fallback || 'en-US';
+
+		refs.previewPosition.replaceChildren(
+			...Zotero.StylePreview.POSITIONS.map(p => h('option', { value: p.id, text: p.id }))
+		);
+
+		let labels = Zotero.Cite.labels || ['page'];
+		refs.previewLocatorLabel.replaceChildren(
+			...labels.map(label => h('option', { value: label, text: Zotero.Cite.getLocatorString(label) }))
+		);
+		refs.previewLocatorLabel.value = 'page';
+	}
+
+	function getPreviewItems() {
+		let pane = Zotero.getActiveZoteroPane && Zotero.getActiveZoteroPane();
+		let items = pane ? pane.getSelectedItems() : [];
+		return items.filter(item => item.isRegularItem()).slice(0, MAX_PREVIEW_ITEMS);
+	}
+
+	/** Re-render if the selection in the library changed since the preview was drawn */
+	function refreshPreviewItems() {
+		let ids = getPreviewItems().map(i => i.id).join(',');
+		if (ids !== lastPreviewItemIDs) schedulePreview(0);
+	}
+
+	function schedulePreview(delay = PREVIEW_DELAY) {
+		clearTimeout(previewTimer);
+		previewTimer = setTimeout(renderPreview, delay);
+	}
+
+	function renderPreview() {
+		if (!doc) return;
+		let items = getPreviewItems();
+		lastPreviewItemIDs = items.map(i => i.id).join(',');
+		document.l10n.setAttributes(
+			refs.previewItems,
+			items.length ? 'visualStyleEditor-preview-items' : 'visualStyleEditor-preview-no-items',
+			{ count: items.length }
+		);
+		let result = Zotero.StylePreview.render(doc.toXML(), {
+			items,
+			locale: refs.previewLocale.value,
+			locator: refs.previewLocator.value.trim(),
+			locatorLabel: refs.previewLocatorLabel.value,
+			suppressAuthor: refs.previewSuppress.checked,
+			position: refs.previewPosition.value
+		});
+		refs.preview.srcdoc = Zotero.StylePreview.wrapDocument(result.html);
+	}
+
+
+	//
+	// Wiring
+	//
+
+	function bindEvents() {
+		refs.tree.addEventListener('click', onTreeClick);
+		refs.tree.addEventListener('keydown', onTreeKeyDown);
+		refs.tree.addEventListener('dragstart', onDragStart);
+		refs.tree.addEventListener('dragover', onDragOver);
+		refs.tree.addEventListener('dragleave', clearDropMarks);
+		refs.tree.addEventListener('drop', onDrop);
+		refs.tree.addEventListener('dragend', onDragEnd);
+
+		refs.undo.addEventListener('click', () => doc.undo());
+		refs.redo.addEventListener('click', () => doc.redo());
+		refs.up.addEventListener('click', () => moveSelected(-1));
+		refs.down.addEventListener('click', () => moveSelected(1));
+		refs.duplicate.addEventListener('click', duplicateSelected);
+		refs.group.addEventListener('click', groupSelected);
+		refs.ungroup.addEventListener('click', ungroupSelected);
+		refs.delete.addEventListener('click', deleteSelected);
+		refs.add.addEventListener('change', () => {
+			let kind = refs.add.value;
+			refs.add.value = '';
+			if (kind) addElement(kind);
+		});
+
+		refs.open.addEventListener('change', async () => {
+			let styleID = refs.open.value;
+			refs.open.value = '';
+			if (styleID) await this.openRequest({ styleID });
+		});
+		refs.new.addEventListener('change', async () => {
+			let kind = refs.new.value;
+			refs.new.value = '';
+			if (kind) await this.openRequest({ kind });
+		});
+
+		refs.ai.addEventListener('click', openAI);
+		refs.xml.addEventListener('click', toggleXMLView);
+		refs.xmlApply.addEventListener('click', applyXML);
+		refs.xmlClose.addEventListener('click', toggleXMLView);
+		refs.save.addEventListener('click', saveAs);
+		refs.install.addEventListener('click', install);
+		refs.gotoError.addEventListener('click', gotoError);
+
+		for (let el of [refs.previewLocale, refs.previewPosition, refs.previewLocatorLabel, refs.previewSuppress]) {
+			el.addEventListener('change', () => {
+				if (el === refs.previewLocale) Zotero.Prefs.set('export.lastLocale', el.value);
+				schedulePreview(0);
+			});
+		}
+		refs.previewLocator.addEventListener('input', () => schedulePreview());
+		refs.previewRefresh.addEventListener('click', () => schedulePreview(0));
+
+		window.addEventListener('keydown', (event) => {
+			let accel = Zotero.isMac ? event.metaKey : event.ctrlKey;
+			if (!accel || event.altKey) return;
+			// Leave the text fields' own undo alone
+			let tag = (event.target.tagName || '').toLowerCase();
+			if (['input', 'textarea', 'select'].includes(tag)) return;
+			let key = event.key.toLowerCase();
+			if (key === 'z' && !event.shiftKey) {
+				doc.undo();
+				event.preventDefault();
+			}
+			else if ((key === 'z' && event.shiftKey) || key === 'y') {
+				doc.redo();
+				event.preventDefault();
+			}
+		});
+
+		// Closing with unsaved work asks first
+		window.addEventListener('close', (event) => {
+			if (!confirmDiscard()) event.preventDefault();
+		});
+	}
+}();
+
+window.addEventListener('load', (event) => {
+	if (event.target !== document) return;
+	Zotero_VisualStyleEditor.init().catch((e) => {
+		Zotero.logError(e);
+	});
+});
diff --git a/chrome/content/zotero/xpcom/styleAI/claudeClient.js b/chrome/content/zotero/xpcom/styleAI/claudeClient.js
new file mode 100644
index 0000000..0d11186
--- /dev/null
+++ b/chrome/content/zotero/xpcom/styleAI/claudeClient.js
@@ -0,0 +1,194 @@
+"use strict";
+
+/**
+ * A small client for the Claude Messages API
+ *
+ * It takes a `request` function instead of making HTTP calls itself, so the same code runs in the
+ * application (where the function wraps Zotero.HTTP) and in Node tests (where it is a fake).
+ *
+ *   request(url, { method, headers, body, timeout }) -> Promise<{ status: Number, text: String }>
+ *
+ * It should resolve for any HTTP status and reject only if no response arrived at all.
+ *
+ * Errors are ClaudeAPIError with a `kind` the interface can act on:
+ *   auth        the key is missing, wrong or revoked (401, 403)
+ *   rate-limit  too many requests (429); retried automatically first
+ *   overloaded  the service is busy (529, 5xx); retried automatically first
+ *   too-large   the request is over the size limit (413)
+ *   invalid     the request was rejected (400, 404, 422); `message` says why
+ *   network     no response arrived
+ *   bad-reply   a response arrived that isn't what the API sends
+ *
+ * Tested in plain Node: fork/test/claudeClient.test.js
+ */
+(function (root) {
+	const DEFAULTS = {
+		baseURL: 'https://api.anthropic.com',
+		version: '2023-06-01',
+		model: 'claude-sonnet-5-5',
+		maxTokens: 16000,
+		timeout: 300000,
+		retries: 2
+	};
+
+	class ClaudeAPIError extends Error {
+		constructor(kind, message, status) {
+			super(message);
+			this.name = 'ClaudeAPIError';
+			this.kind = kind;
+			this.status = status || null;
+		}
+	}
+
+	function kindForStatus(status) {
+		if (status === 401 || status === 403) return 'auth';
+		if (status === 429) return 'rate-limit';
+		if (status === 413) return 'too-large';
+		if (status === 529 || status >= 500) return 'overloaded';
+		return 'invalid';
+	}
+
+	function isRetryable(kind) {
+		return kind === 'rate-limit' || kind === 'overloaded';
+	}
+
+	/** Pull the API's own explanation out of an error response, if it sent one */
+	function errorMessage(text, status) {
+		try {
+			let body = JSON.parse(text);
+			if (body && body.error && body.error.message) return body.error.message;
+		}
+		catch (e) {
+			// Not JSON; fall through
+		}
+		return `The request failed (HTTP ${status})`;
+	}
+
+	function defaultSleep(ms) {
+		return new Promise(resolve => setTimeout(resolve, ms));
+	}
+
+	/**
+	 * @param {Object} options
+	 * @param {String} options.apiKey
+	 * @param {Function} options.request - See above
+	 * @param {String} [options.model]
+	 * @param {Number} [options.maxTokens]
+	 * @param {Number} [options.timeout] - Milliseconds to wait for a reply
+	 * @param {Number} [options.retries] - Extra attempts after a rate-limit or overload error
+	 * @param {Function} [options.sleep] - For tests: (ms) => Promise
+	 */
+	function createClient(options) {
+		let settings = Object.assign({}, DEFAULTS, options);
+		let { apiKey, request, sleep = defaultSleep } = settings;
+		if (!apiKey) throw new ClaudeAPIError('auth', 'No API key has been set');
+		if (typeof request !== 'function') throw new Error('A request function is required');
+
+		async function attempt(body) {
+			let response;
+			try {
+				response = await request(`${settings.baseURL}/v1/messages`, {
+					method: 'POST',
+					headers: {
+						'content-type': 'application/json',
+						'x-api-key': apiKey,
+						'anthropic-version': settings.version
+					},
+					body: JSON.stringify(body),
+					timeout: settings.timeout
+				});
+			}
+			catch (e) {
+				throw new ClaudeAPIError('network', `Couldn't reach the Claude API: ${e && e.message || e}`);
+			}
+
+			if (response.status < 200 || response.status >= 300) {
+				throw new ClaudeAPIError(
+					kindForStatus(response.status),
+					errorMessage(response.text, response.status),
+					response.status
+				);
+			}
+
+			let data;
+			try {
+				data = JSON.parse(response.text);
+			}
+			catch (e) {
+				throw new ClaudeAPIError('bad-reply', 'The Claude API sent a reply that could not be read', response.status);
+			}
+			if (!data || !Array.isArray(data.content)) {
+				throw new ClaudeAPIError('bad-reply', 'The Claude API reply had no content', response.status);
+			}
+			return {
+				text: data.content.filter(b => b.type === 'text').map(b => b.text).join(''),
+				stopReason: data.stop_reason || null,
+				usage: data.usage || null,
+				model: data.model || settings.model
+			};
+		}
+
+		return {
+			model: settings.model,
+
+			/**
+			 * Send a conversation and wait for the whole reply
+			 * @param {Object} args
+			 * @param {String} [args.system]
+			 * @param {Array} args.messages - [{ role: 'user'|'assistant', content: String|Block[] }]
+			 * @param {Number} [args.maxTokens]
+			 * @return {Promise<{ text, stopReason, usage, model }>}
+			 */
+			async send({ system, messages, maxTokens }) {
+				let body = {
+					model: settings.model,
+					max_tokens: maxTokens || settings.maxTokens,
+					messages
+				};
+				if (system) body.system = system;
+
+				let lastError;
+				for (let n = 0; n <= settings.retries; n++) {
+					try {
+						return await attempt(body);
+					}
+					catch (e) {
+						lastError = e;
+						if (!(e instanceof ClaudeAPIError) || !isRetryable(e.kind) || n === settings.retries) throw e;
+						// Wait longer each time: 2s, then 6s
+						await sleep(2000 * (n * 2 + 1));
+					}
+				}
+				throw lastError;
+			}
+		};
+	}
+
+	/** A short explanation a person can act on, for each kind of error */
+	function describeError(error) {
+		if (!(error instanceof ClaudeAPIError)) return String(error && error.message || error);
+		switch (error.kind) {
+			case 'auth':
+				return 'The API key was not accepted. Check it in the AI settings and try again.';
+			case 'rate-limit':
+				return 'The Claude API is limiting requests right now. Wait a minute and try again.';
+			case 'overloaded':
+				return 'The Claude API is busy. Try again in a few minutes.';
+			case 'too-large':
+				return 'The material is too large to send. Use fewer pages of the manual, or paste only the relevant sections.';
+			case 'network':
+				return error.message;
+			default:
+				return error.message;
+		}
+	}
+
+	const api = { DEFAULTS, ClaudeAPIError, createClient, describeError };
+
+	if (typeof module !== 'undefined' && module.exports) {
+		module.exports = api;
+	}
+	else if (root) {
+		root.ClaudeClient = api;
+	}
+})(typeof Zotero !== 'undefined' ? Zotero : null);
diff --git a/chrome/content/zotero/xpcom/styleAI/styleAI.js b/chrome/content/zotero/xpcom/styleAI/styleAI.js
new file mode 100644
index 0000000..e38fd66
--- /dev/null
+++ b/chrome/content/zotero/xpcom/styleAI/styleAI.js
@@ -0,0 +1,226 @@
+"use strict";
+
+/**
+ * The AI style writer: the part that touches the application
+ *
+ * Writes a citation style by sending a style manual and/or example citations to Claude (the
+ * Anthropic API), using the person's own API key. The prompt, reply handling and repair loop are
+ * in styleGenPrompt.js and styleGenerator.js (tested in plain Node); the API client is in
+ * claudeClient.js. This file supplies what only the application can: where the key is kept, how
+ * files are read, how requests are sent, and the dialog (tools/styleAI.html).
+ *
+ * What leaves the computer: the text of whatever manual, examples and instructions the person
+ * adds (a PDF is sent whole), plus, when revising, the style being revised. Nothing from the
+ * library is sent. The API key is stored with the login manager, encrypted with the operating
+ * system's key store, and is sent only to api.anthropic.com.
+ */
+Zotero.StyleAI = new function () {
+	const PREF = 'styleAI.';
+	const LOGIN_HOST = 'chrome://typos-style-ai';
+	const LOGIN_REALM = 'Claude API key';
+	const LOGIN_USER = 'api-key';
+	const WINDOW_TYPE = 'zotero:style-ai';
+	const WINDOW_URL = 'chrome://zotero/content/tools/styleAI.html';
+	const WINDOW_FEATURES = 'chrome,width=760,height=820,resizable,centerscreen';
+	const TEXT_EXTENSIONS = ['txt', 'md', 'markdown', 'html', 'htm', 'xml', 'csv'];
+
+	var _pending = null;
+
+	this.WINDOW_TYPE = WINDOW_TYPE;
+
+
+	//
+	// Settings
+	//
+
+	this.getModel = function () {
+		return (Zotero.Prefs.get(PREF + 'model') || Zotero.ClaudeClient.DEFAULTS.model).trim();
+	};
+
+	this.setModel = function (model) {
+		Zotero.Prefs.set(PREF + 'model', (model || '').trim());
+	};
+
+	/** Whether the person has seen what is sent to Anthropic and agreed to it */
+	this.hasAcknowledgedPrivacy = function () {
+		return !!Zotero.Prefs.get(PREF + 'acknowledged');
+	};
+
+	this.acknowledgePrivacy = function () {
+		Zotero.Prefs.set(PREF + 'acknowledged', true);
+	};
+
+
+	//
+	// API key (login manager, encrypted with the OS key store like the sync API key)
+	//
+
+	async function findLogin() {
+		let logins = await Services.logins.searchLoginsAsync({
+			origin: LOGIN_HOST,
+			httpRealm: LOGIN_REALM
+		});
+		return logins.find(l => l.username === LOGIN_USER) || null;
+	}
+
+	this.getApiKey = async function () {
+		let login = await findLogin();
+		if (!login) return null;
+		return Zotero.OSKeyStore.isEncrypted(login.password)
+			? Zotero.OSKeyStore.decrypt(login.password)
+			: login.password;
+	};
+
+	this.hasApiKey = async function () {
+		return !!(await findLogin());
+	};
+
+	this.setApiKey = async function (key) {
+		key = (key || '').trim();
+		if (!key) throw new Error('Enter an API key');
+		let old = await findLogin();
+		let LoginInfo = new Components.Constructor(
+			"@mozilla.org/login-manager/loginInfo;1",
+			Components.interfaces.nsILoginInfo,
+			"init"
+		);
+		let stored = await Zotero.OSKeyStore.encrypt(key);
+		let info = new LoginInfo(LOGIN_HOST, null, LOGIN_REALM, LOGIN_USER, stored, '', '');
+		if (old) {
+			Services.logins.modifyLogin(old, info);
+		}
+		else {
+			await Services.logins.addLoginAsync(info);
+		}
+	};
+
+	this.clearApiKey = async function () {
+		let old = await findLogin();
+		if (old) Services.logins.removeLogin(old);
+	};
+
+
+	//
+	// Files
+	//
+
+	function extensionOf(path) {
+		let m = /\.([A-Za-z0-9]+)$/.exec(path);
+		return m ? m[1].toLowerCase() : '';
+	}
+
+	function toBase64(bytes) {
+		// btoa wants a string, and String.fromCharCode can't take millions of arguments
+		let chunks = [];
+		const SIZE = 0x8000;
+		for (let i = 0; i < bytes.length; i += SIZE) {
+			chunks.push(String.fromCharCode.apply(null, bytes.subarray(i, i + SIZE)));
+		}
+		return btoa(chunks.join(''));
+	}
+
+	function htmlToText(html) {
+		let doc = new DOMParser().parseFromString(html, 'text/html');
+		for (let el of doc.querySelectorAll('script, style')) el.remove();
+		return (doc.body.textContent || '').replace(/\n{3,}/g, '\n\n').trim();
+	}
+
+	/**
+	 * Read a style manual from disk
+	 * @param {String} path
+	 * @return {Promise<{ kind: 'pdf', name, base64 } | { kind: 'text', name, text }>}
+	 */
+	this.readManual = async function (path) {
+		let name = PathUtils.filename(path);
+		let ext = extensionOf(path);
+		let limit = Zotero.StyleGenPrompt.MAX_PDF_BYTES;
+		if (ext === 'pdf') {
+			let { size } = await IOUtils.stat(path);
+			if (size > limit) {
+				throw new Error('That PDF is too large to send. Use a copy with only the pages on citations and bibliographies.');
+			}
+			let bytes = await IOUtils.read(path);
+			return { kind: 'pdf', name, base64: toBase64(bytes) };
+		}
+		if (!TEXT_EXTENSIONS.includes(ext)) {
+			throw new Error('Choose a PDF, or a text, Markdown or HTML file. For a Word file, save it as PDF first.');
+		}
+		let text = await IOUtils.readUTF8(path);
+		if (ext === 'html' || ext === 'htm') text = htmlToText(text);
+		return { kind: 'text', name, text };
+	};
+
+
+	//
+	// Generating
+	//
+
+	// Zotero.HTTP wrapped to the shape claudeClient wants: always resolves with a status if the
+	// server answered; never retries on its own (the client does that); never logs the body
+	function httpRequest(url, { method, headers, body, timeout }) {
+		return Zotero.HTTP.request(method, url, {
+			headers,
+			body,
+			timeout,
+			successCodes: false,
+			errorDelayMax: 0,
+			logBodyLength: 0,
+			responseType: 'text'
+		}).then(xhr => ({ status: xhr.status, text: xhr.responseText }));
+	}
+
+	/**
+	 * @param {Object} inputs - See styleGenPrompt.buildUserContent
+	 * @param {Object} [options]
+	 * @param {Function} [options.onProgress]
+	 * @param {Function} [options.isCancelled]
+	 * @return {Promise<Object>} - See styleGenerator.generateStyle
+	 */
+	this.generate = async function (inputs, options = {}) {
+		let apiKey = await this.getApiKey();
+		let client = Zotero.ClaudeClient.createClient({
+			apiKey,
+			request: httpRequest,
+			model: this.getModel()
+		});
+		return Zotero.StyleGenerator.generateStyle({
+			client,
+			inputs,
+			validate: xml => Zotero.VisualStyleEditor.validate(xml),
+			existingIds: Zotero.VisualStyleEditor.getInstalledStyleIDs(),
+			onProgress: options.onProgress,
+			isCancelled: options.isCancelled
+		});
+	};
+
+	this.describeError = function (e) {
+		if (e && e.name === 'InputError') return e.message;
+		return Zotero.ClaudeClient.describeError(e);
+	};
+
+
+	//
+	// Dialog
+	//
+
+	/**
+	 * @param {Object} [request]
+	 * @param {String} [request.currentXML] - The style open in the editor, offered as a starting point
+	 * @param {Window} [request.parentWindow]
+	 */
+	this.openDialog = function (request = {}) {
+		let existing = Services.wm.getMostRecentWindow(WINDOW_TYPE);
+		if (existing) {
+			existing.focus();
+			return existing;
+		}
+		_pending = request;
+		return Services.ww.openWindow(request.parentWindow || null, WINDOW_URL, '_blank', WINDOW_FEATURES, null);
+	};
+
+	this.takePending = function () {
+		let request = _pending;
+		_pending = null;
+		return request;
+	};
+}();
diff --git a/chrome/content/zotero/xpcom/styleAI/styleGenPrompt.js b/chrome/content/zotero/xpcom/styleAI/styleGenPrompt.js
new file mode 100644
index 0000000..84be6c5
--- /dev/null
+++ b/chrome/content/zotero/xpcom/styleAI/styleGenPrompt.js
@@ -0,0 +1,309 @@
+"use strict";
+
+/**
+ * What to tell Claude when asking it to write a citation style, and how to read what comes back
+ *
+ * Nothing here makes a network call or touches Zotero, so it can be tested in plain Node
+ * (fork/test/styleGenPrompt.test.js). Calling the API is claudeClient.js; the write, check and
+ * repair loop is styleGenerator.js.
+ *
+ * A style is asked for as one complete CSL file in an ```xml block, followed by notes on the
+ * assumptions made. Starting every request from a working skeleton (cslTemplates.js) is what keeps
+ * the results valid; the model adapts a structure rather than inventing one.
+ */
+(function (root) {
+	const isNode = typeof module !== 'undefined' && module.exports;
+	const Schema = isNode ? require('../styleEditor/cslSchema.js') : root.CSLSchema;
+	const Tree = isNode ? require('../styleEditor/cslTree.js') : root.CSLTree;
+	const Templates = isNode ? require('../styleEditor/cslTemplates.js') : root.CSLTemplates;
+
+	// Limits chosen to keep a request inside what the API accepts, with room for the reply
+	const MAX_MANUAL_CHARS = 400000;
+	const MAX_PDF_BYTES = 24 * 1024 * 1024;
+	const MAX_EXAMPLE_CHARS = 60000;
+
+	class InputError extends Error {
+		constructor(message) {
+			super(message);
+			this.name = 'InputError';
+		}
+	}
+
+	class NoStyleError extends Error {
+		constructor(message) {
+			super(message);
+			this.name = 'NoStyleError';
+		}
+	}
+
+	function system() {
+		return `You write citation styles in Citation Style Language (CSL) 1.0.2 for a reference manager used by scholars of classical and ancient texts. You are precise and conservative: you follow the rules you are given, and you say so when something cannot be expressed in CSL.
+
+# How to reply
+
+Reply with ONE complete CSL file inside a single \`\`\`xml code block: a whole <style> document, never a fragment or a diff. Say nothing before the code block. After it, add a short list headed "Notes" (at most eight lines) covering assumptions you made, rules from the source material that CSL cannot express, and anything the person should check against their manual.
+
+# How to build the style
+
+- Start from the skeleton you are given and adapt it. Keep its overall structure (info, macros, citation, bibliography) unless the style truly needs something different.
+- Use only CSL 1.0.2 elements, attributes and values. Never invent an attribute. The most common mistakes: attributes that don't exist (such as if-missing), the wrong values for form or text-case, a text element with more than one of variable, macro, term and value, and macros that are called but never defined.
+- Every macro you call must be defined exactly once, and every macro you define must be used.
+- A text element takes exactly one of variable, macro, term or value. Put literal punctuation in prefix, suffix or a group's delimiter; use value only for fixed words.
+- Join parts with a group and its delimiter, not with separate punctuation elements. A group that produces no output because all its variables are empty disappears with its punctuation, which is what you want.
+- In a names element the children come in this order: name, et-al, label, then substitute (always last). Name options such as and, initialize-with, name-as-sort-order, et-al-min and et-al-use-first go on name or on the citation or bibliography element.
+- A choose has an if, then any number of else-if, then at most one else. The if tests are type, variable, is-numeric, locator, position (first, subsequent, ibid, ibid-with-locator, near-note) and disambiguate; match is all, any or none.
+- Note styles (footnotes) use class="note" and usually give a full first note and a shortened later note by testing position in the citation layout. Author-date and numeric styles use class="in-text".
+- Formatting attributes: font-style (normal, italic, oblique), font-weight (normal, bold, light), font-variant (normal, small-caps), text-decoration (none, underline), vertical-align (baseline, sup, sub); text-case (lowercase, uppercase, capitalize-first, capitalize-all, title, sentence); quotes="true".
+- Put the citation sort and bibliography sort in a sort element before the layout, using keys that are macros or variables.
+- The pin cite (page, line, section) arrives as the locator variable with a locator label. Render it with a label element (variable="locator", form="short") followed by text variable="locator". Citations to ancient works often have no label (for example "Il. 1.1" or "Rep. 514a"); when the source material shows that, render the locator text alone.
+- Ancient and classical works are held as book-type items with the author, title, and any original date, publisher or place; do not invent variables for reference systems.
+
+# Standard CSL variables you may use
+
+Text: ${Schema.VARIABLES.standard.join(', ')}.
+Number: ${Schema.VARIABLES.number.join(', ')}.
+Date: ${Schema.VARIABLES.date.join(', ')}.
+Names: ${Schema.VARIABLES.names.join(', ')}.
+
+Item types: ${Schema.ITEM_TYPES.join(', ')}.
+
+# Reading the source material
+
+- A style manual states rules; examples show results. When they disagree, follow the manual and mention the difference in the Notes.
+- From examples, work out each element and the punctuation between elements, systematically: names (order, initials, "and", how many before "et al."), dates, titles (italic or quoted, capitalization), container, volume, issue, pages, publisher and place, and what changes by item type. Then write rules that reproduce every example, not just the first.
+- Never copy the content of an example into the style. "Smith" and "Oxford" in an example are data, not text to put in value attributes.
+- Italics in pasted examples are marked with *single asterisks* and bold with **double asterisks**; small capitals with ^^double carets^^ if the person uses them.
+- If a rule is ambiguous or missing, choose the most common scholarly convention for the discipline and list the choice in the Notes.`;
+	}
+
+	/** The skeleton for a new style, with the requested title, as XML text */
+	function skeleton(kind, title, locale, id, updated) {
+		let useKind = Templates.KINDS[kind] ? kind : 'author-date';
+		return Templates.newStyleXML(useKind, { title, locale, id, updated });
+	}
+
+	function tag(name, body) {
+		return `<${name}>\n${body.trim()}\n</${name}>`;
+	}
+
+	/** Why these inputs can't be sent, as a message for the person, or null if they can */
+	function checkInputs(inputs) {
+		let hasManual = !!(inputs.manualText && inputs.manualText.trim()) || !!inputs.manualPDF;
+		let hasExamples = !!((inputs.bibExamples || '').trim() || (inputs.citeExamples || '').trim());
+		let hasExtra = !!(inputs.extra || '').trim();
+		if (inputs.mode === 'revise') {
+			if (!inputs.baseXML) return 'There is no style to revise.';
+			if (!hasManual && !hasExamples && !hasExtra) return 'Say what to change: add examples, a manual, or instructions.';
+		}
+		else if (!hasManual && !hasExamples && !hasExtra) {
+			return 'Add a style manual, some example citations, or a description of the style.';
+		}
+		if (inputs.manualText && inputs.manualText.length > MAX_MANUAL_CHARS) {
+			return 'The manual text is too long to send in one go. Paste only the chapters on citations and bibliographies.';
+		}
+		if (inputs.manualPDF) {
+			let bytes = Math.floor(inputs.manualPDF.base64.length * 3 / 4);
+			if (bytes > MAX_PDF_BYTES) {
+				return 'The PDF is too large to send. Use a copy with only the pages on citations and bibliographies.';
+			}
+		}
+		for (let key of ['bibExamples', 'citeExamples', 'extra']) {
+			if ((inputs[key] || '').length > MAX_EXAMPLE_CHARS) return 'The examples are too long. Trim them to a representative set.';
+		}
+		return null;
+	}
+
+	/**
+	 * The first user message, as content blocks
+	 * @param {Object} inputs
+	 * @param {'new'|'revise'} inputs.mode
+	 * @param {String} inputs.title - Name of the style
+	 * @param {String} [inputs.kind] - 'author-date', 'numeric', 'note', or 'auto'
+	 * @param {String} [inputs.locale='en-US']
+	 * @param {String} [inputs.manualText]
+	 * @param {{ name: String, base64: String }} [inputs.manualPDF]
+	 * @param {String} [inputs.bibExamples] - Example bibliography entries
+	 * @param {String} [inputs.citeExamples] - Example in-text citations or notes
+	 * @param {String} [inputs.extra] - Anything else the person wants
+	 * @param {String} [inputs.baseXML] - The style to revise (mode 'revise')
+	 * @param {String} [inputs.id]
+	 * @param {String} [inputs.updated]
+	 */
+	function buildUserContent(inputs) {
+		let problem = checkInputs(inputs);
+		if (problem) throw new InputError(problem);
+
+		let locale = inputs.locale || 'en-US';
+		let blocks = [];
+		if (inputs.manualPDF) {
+			// Documents go before the text that refers to them
+			blocks.push({
+				type: 'document',
+				source: { type: 'base64', media_type: 'application/pdf', data: inputs.manualPDF.base64 },
+				title: inputs.manualPDF.name || 'Style manual'
+			});
+		}
+
+		let parts = [];
+		let kindNote = inputs.kind && inputs.kind !== 'auto' && Templates.KINDS[inputs.kind]
+			? ` It should be a ${Templates.KINDS[inputs.kind].label.toLowerCase()} style.`
+			: ' Decide from the material whether it is an author-date, numeric or note style.';
+
+		if (inputs.mode === 'revise') {
+			parts.push(tag('task', `Revise the CSL style below so that it follows the material provided. Keep everything that already matches. Keep its title "${inputs.title}", its id and its locale unless told otherwise. Return the complete revised file.`));
+		}
+		else {
+			parts.push(tag('task', `Write a new CSL style titled "${inputs.title}" (default locale ${locale}) that follows the material provided.${kindNote} Adapt the skeleton below.`));
+		}
+		if (inputs.manualPDF) parts.push(tag('style_manual_note', 'The style manual is attached as a PDF. The rules about citations and bibliographies are what matter; ignore the rest.'));
+		if (inputs.manualText && inputs.manualText.trim()) parts.push(tag('style_manual', inputs.manualText));
+		if ((inputs.bibExamples || '').trim()) parts.push(tag('bibliography_examples', inputs.bibExamples));
+		if ((inputs.citeExamples || '').trim()) parts.push(tag('citation_examples', inputs.citeExamples));
+		if ((inputs.extra || '').trim()) parts.push(tag('additional_instructions', inputs.extra));
+
+		if (inputs.mode === 'revise') {
+			parts.push(tag('current_style', inputs.baseXML));
+		}
+		else {
+			parts.push(tag('skeleton', skeleton(inputs.kind, inputs.title, locale, inputs.id, inputs.updated)));
+		}
+		blocks.push({ type: 'text', text: parts.join('\n\n') });
+		return blocks;
+	}
+
+	/** A follow-up asking for the problems in the last reply to be fixed */
+	function buildRepairMessage(problems) {
+		let list = problems.slice(0, 15).map(p => `- ${p}`).join('\n');
+		let more = problems.length > 15 ? `\n(${problems.length - 15} more not shown.)` : '';
+		return `That file has problems:\n${list}${more}\n\nFix them and send the complete corrected style again in a single \`\`\`xml block, followed by the Notes list. Change nothing else.`;
+	}
+
+
+	//
+	// Reading the reply
+	//
+
+	/**
+	 * Find the style in a reply
+	 * @return {{ xml: String, notes: String }}
+	 * @throws {NoStyleError}
+	 */
+	function extractStyle(text) {
+		text = String(text || '');
+		let xml = null;
+		let rest = '';
+
+		let fence = /```(?:xml|csl)?[ \t]*\r?\n([\s\S]*?)```/gi;
+		let match;
+		while ((match = fence.exec(text))) {
+			if (/<style[\s>]/.test(match[1])) {
+				xml = match[1].trim();
+				rest = text.slice(match.index + match[0].length);
+				break;
+			}
+		}
+		if (xml === null) {
+			// No fence: take from the XML declaration or <style to the last </style>
+			let start = text.search(/<\?xml[\s\S]*?\?>\s*<style[\s>]|<style[\s>]/);
+			let endTag = text.lastIndexOf('</style>');
+			if (start !== -1 && endTag > start) {
+				xml = text.slice(start, endTag + '</style>'.length).trim();
+				rest = text.slice(endTag + '</style>'.length);
+			}
+		}
+		if (xml === null) throw new NoStyleError('The reply did not contain a style');
+
+		let notes = rest.replace(/```/g, '').trim().replace(/^#*\s*\**notes\**:?\**\s*/i, '').trim();
+		return { xml, notes };
+	}
+
+	/**
+	 * Problems that the schema validator does not catch but that stop a style working: macros
+	 * called but not defined, missing sections, no layout
+	 * @return {String[]}
+	 */
+	function checkSemantics(xml) {
+		let doc;
+		try {
+			doc = Tree.StyleDoc.fromXML(xml);
+		}
+		catch (e) {
+			return [`The XML cannot be read: ${e.message}`];
+		}
+		let problems = [];
+		if (Schema.localName(doc.root.name) !== 'style') problems.push('The root element must be <style>');
+		if (!doc.findAll('citation').length) problems.push('The style has no <citation> section');
+		let citation = doc.findAll('citation')[0];
+		if (citation && !Tree.elementChildren(citation).some(c => c.name === 'layout')) {
+			problems.push('The <citation> section has no <layout>');
+		}
+		for (let name of doc.undefinedMacros()) {
+			problems.push(`Macro "${name}" is used but never defined`);
+		}
+		let seen = new Set();
+		for (let m of doc.macros()) {
+			if (seen.has(m.name)) problems.push(`Macro "${m.name}" is defined more than once`);
+			seen.add(m.name);
+		}
+		for (let m of doc.unusedMacros()) {
+			problems.push(`Macro "${m.name}" is defined but never used`);
+		}
+		return problems;
+	}
+
+	/**
+	 * Give a generated style the identity it should have: the requested title, a fresh ID that
+	 * does not clash with an installed style, and the current time; and remove links that would
+	 * make it claim to be somebody else's style.
+	 *
+	 * @param {String} xml
+	 * @param {Object} options
+	 * @param {String} [options.title] - Overrides the title the model chose
+	 * @param {String} [options.id] - Keep this id (used when revising)
+	 * @param {Iterable<String>} [options.existingIds]
+	 * @param {String} [options.now]
+	 * @throws {Tree.CSLParseError}
+	 */
+	function finalizeStyle(xml, options = {}) {
+		let doc = Tree.StyleDoc.fromXML(xml);
+		if (Schema.localName(doc.root.name) !== 'style') throw new NoStyleError('The reply was not a style');
+		if (!doc.findAll('info').length) throw new NoStyleError('The style has no information block');
+
+		if (!doc.root.attrs.some(a => a.name === 'xmlns')) doc.setAttr(doc.root.id, 'xmlns', Schema.CSL_NAMESPACE);
+
+		let title = options.title || doc.getInfo('title') || 'Untitled style';
+		doc.setInfo('title', title);
+		doc.setInfo('id', options.id || Templates.makeStyleId(title, options.existingIds || []));
+		doc.setInfo('updated', options.now || new Date().toISOString());
+
+		let info = doc.findAll('info')[0];
+		for (let child of Tree.elementChildren(info).slice()) {
+			if (child.name === 'link' && ['self', 'independent-parent', 'template'].includes(Tree.getAttr(child, 'rel'))) {
+				doc.remove(child.id);
+			}
+		}
+		return doc.toXML();
+	}
+
+	const api = {
+		MAX_MANUAL_CHARS,
+		MAX_PDF_BYTES,
+		InputError,
+		NoStyleError,
+		system,
+		skeleton,
+		checkInputs,
+		buildUserContent,
+		buildRepairMessage,
+		extractStyle,
+		checkSemantics,
+		finalizeStyle
+	};
+
+	if (isNode) {
+		module.exports = api;
+	}
+	else if (root) {
+		root.StyleGenPrompt = api;
+	}
+})(typeof Zotero !== 'undefined' ? Zotero : null);
diff --git a/chrome/content/zotero/xpcom/styleAI/styleGenerator.js b/chrome/content/zotero/xpcom/styleAI/styleGenerator.js
new file mode 100644
index 0000000..5feae93
--- /dev/null
+++ b/chrome/content/zotero/xpcom/styleAI/styleGenerator.js
@@ -0,0 +1,169 @@
+"use strict";
+
+/**
+ * Ask Claude for a citation style, check it, and ask for fixes until it passes (or we give up)
+ *
+ * Pure: the client, the validator and the progress callback are passed in, so this runs in
+ * plain Node (fork/test/styleGenerator.test.js) as well as in the application.
+ *
+ *   generateStyle({
+ *     client,                 // { send({ system, messages }) -> { text, stopReason, usage } }
+ *     inputs,                 // see styleGenPrompt.buildUserContent
+ *     validate,               // async (xml) -> null | String | String[]  (schema errors)
+ *     existingIds,            // ids already installed, so the new one is unique
+ *     onProgress,             // (step, info) where step is reading | writing | checking | fixing | done
+ *     isCancelled,            // () -> Boolean, checked between steps
+ *     maxRepairs = 2
+ *   }) -> { xml, notes, validationErrors, attempts, usage }
+ *
+ * `validationErrors` is empty when the style passed every check. If it isn't, the style is still
+ * returned so the person can open it in the visual editor and fix the rest by hand.
+ */
+(function (root) {
+	const isNode = typeof module !== 'undefined' && module.exports;
+	const Prompt = isNode ? require('./styleGenPrompt.js') : root.StyleGenPrompt;
+
+	class CancelledError extends Error {
+		constructor() {
+			super('Cancelled');
+			this.name = 'CancelledError';
+		}
+	}
+
+	function normalizeErrors(result) {
+		if (!result) return [];
+		let list = Array.isArray(result) ? result : String(result).split(/\r?\n/);
+		return list
+			.map(line => String(line).trim())
+			// "file:12:3: error: message" -> "line 12: message"
+			.map(line => line.replace(/^[^:\s]*:(\d+):\d+:\s*(?:error|warning):\s*/i, 'line $1: '))
+			.filter(Boolean);
+	}
+
+	function addUsage(total, usage) {
+		if (!usage) return total;
+		return {
+			input_tokens: (total.input_tokens || 0) + (usage.input_tokens || 0),
+			output_tokens: (total.output_tokens || 0) + (usage.output_tokens || 0)
+		};
+	}
+
+	async function generateStyle(options) {
+		let {
+			client, inputs, validate,
+			existingIds = [], onProgress = () => {}, isCancelled = () => false,
+			maxRepairs = 2, now
+		} = options;
+
+		let check = () => {
+			if (isCancelled()) throw new CancelledError();
+		};
+
+		onProgress('reading');
+		let content = Prompt.buildUserContent(inputs);
+		let system = Prompt.system();
+		let messages = [{ role: 'user', content }];
+
+		// When revising, the style keeps its identity
+		let keepId = null;
+		if (inputs.mode === 'revise') {
+			try {
+				keepId = require_info(inputs.baseXML, 'id');
+			}
+			catch (e) {
+				// Finalizing will make a new one
+			}
+		}
+
+		let usage = {};
+		let best = null;
+		let lastProblems = [];
+		let attempts = 0;
+
+		for (let round = 0; round <= maxRepairs; round++) {
+			check();
+			onProgress(round === 0 ? 'writing' : 'fixing', { round });
+			let reply = await client.send({ system, messages });
+			attempts++;
+			usage = addUsage(usage, reply.usage);

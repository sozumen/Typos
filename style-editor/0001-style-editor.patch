+		flex-wrap: wrap;
+		align-items: center;
+		gap: 4px 14px;
+		padding: 6px 10px;
+		background: var(--material-toolbar);
+		border-bottom: var(--material-panedivider);
+
+		.vse-group {
+			display: flex;
+			align-items: center;
+			gap: 4px;
+		}
+
+		.vse-spacer {
+			flex: 1;
+		}
+
+		button, select {
+			margin: 0;
+		}
+
+		button:disabled, select:disabled {
+			opacity: .45;
+		}
+	}
+
+	button.vse-accent {
+		background: var(--color-accent);
+		color: var(--color-accent-text);
+		border-color: transparent;
+
+		&:disabled {
+			opacity: .45;
+		}
+	}
+
+
+	// Three panes
+
+	#vse-main {
+		flex: 1;
+		min-height: 0;
+		display: grid;
+		grid-template-columns: minmax(260px, 1fr) minmax(300px, 1.1fr) minmax(320px, 1.5fr);
+
+		> section {
+			display: flex;
+			flex-direction: column;
+			min-width: 0;
+			min-height: 0;
+			border-inline-end: var(--material-panedivider);

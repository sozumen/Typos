+			margin-inline-start: 14px;
+			border-inline-start: 1px solid var(--material-border-quinary);
+			padding-inline-start: 2px;
+		}
+	}
+
+	.vse-row-node {
+		display: flex;
+		align-items: baseline;
+		gap: 6px;
+		padding: 3px 8px 3px 4px;
+		margin: 0 4px;
+		border-radius: 4px;

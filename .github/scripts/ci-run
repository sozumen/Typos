#!/bin/bash
# Run a command; if it fails, copy the end of its output into a GitHub error annotation, so the
# reason shows on the run summary page and through the API (not only in the full log).
#
# Usage: ci-run "title" command [args...]
title=$1
shift
log=$(mktemp)
set +e
"$@" 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
set -e
if [ "$status" -ne 0 ]; then
	# Lines that only add noise (set CI_RUN_EXCLUDE to change), then the failed tests with a few
	# lines of context, then the end of the output
	clean=$(mktemp)
	tr -d '\r' < "$log" | grep -Ev "${CI_RUN_EXCLUDE:-single-file-hooks|SingleFileChild|GraphicsCriticalError}" > "$clean" || true
	failures=$(grep -A6 -E '❌|\[FAIL\]' "$clean" | head -n 60 | cut -c1-400 || true)
	tail_text=$(tail -n "${CI_RUN_LINES:-60}" "$clean" | cut -c1-400)
	if [ -n "$failures" ]; then
		tail_text=$(printf 'FAILED TESTS\n%s\n--- end of output ---\n%s' "$failures" "$tail_text")
	fi
	# Annotation messages need %, CR and LF escaped
	tail_text=${tail_text//'%'/'%25'}
	tail_text=${tail_text//$'\n'/'%0A'}
	echo "::error title=$title (exit $status)::$tail_text"
fi
exit "$status"
